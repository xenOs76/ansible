apiVersion: v1
kind: Pod
metadata:
  name: userns-security-pod
  namespace: {{ cka_lab_pods_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: pods
    security.kubernetes.io/isolation: userns
spec:
  hostUsers: false
  restartPolicy: Never
  containers:
    - name: hardened-worker
      image: busybox:1.36.1
      command: ["sleep", "3600"]
      resources:
        requests:
          cpu: 20m
          memory: 32Mi
