apiVersion: v1
kind: Pod
metadata:
  name: cka-dns-diagnostics
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: cluster_troubleshooting
spec:
  restartPolicy: Never
  containers:
  - name: digger
    image: busybox:1.36
    command: ["sleep", "3600"]
    resources:
      requests:
        cpu: 10m
        memory: 16Mi
      limits:
        cpu: 50m
        memory: 32Mi
