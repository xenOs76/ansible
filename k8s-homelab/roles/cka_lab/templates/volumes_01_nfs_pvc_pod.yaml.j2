apiVersion: v1
kind: Pod
metadata:
  name: nfs-pvc-consumer
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-nfs
spec:
  containers:
    - name: reader
      image: busybox:1.36
      command: ["sh", "-c", "while true; do cat /data/shared/shared-data.txt; sleep 15; done"]
      volumeMounts:
        - name: nfs-pvc-volume
          mountPath: /data/shared
  volumes:
    - name: nfs-pvc-volume
      persistentVolumeClaim:
        claimName: nfs-storage-pvc
