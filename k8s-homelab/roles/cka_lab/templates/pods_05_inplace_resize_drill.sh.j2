#!/usr/bin/env bash
# ==============================================================================
# inplace-resize-drill.sh: In-Place Pod Resource Resizing (Kubernetes 1.35+ GA)
# ==============================================================================
set -euo pipefail

NAMESPACE="{{ cka_lab_pods_namespace | default('default') }}"
POD_NAME="cka-lab-resize-pod"

cleanup() {
  echo "==> Cleaning up in-place resize drill resources..."
  kubectl delete pod "${POD_NAME}" -n "${NAMESPACE}" --ignore-not-found=true --now >/dev/null 2>&1 || true
}

trap cleanup EXIT

echo "==> 1. Deploying initial Pod with baseline resource requests & limits..."
cat <<EOF | kubectl apply -f - -n "${NAMESPACE}"
apiVersion: v1
kind: Pod
metadata:
  name: ${POD_NAME}
  labels:
    app.kubernetes.io/name: ${POD_NAME}
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: pods
spec:
  containers:
    - name: worker
      image: busybox:1.36.1
      command: ["/bin/sh", "-c", "sleep 3600"]
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
EOF

echo "Waiting for Pod ${POD_NAME} to become Ready..."
kubectl wait --for=condition=Ready pod/"${POD_NAME}" -n "${NAMESPACE}" --timeout=30s

INITIAL_CPU_REQ=$(kubectl get pod "${POD_NAME}" -n "${NAMESPACE}" -o jsonpath='{.spec.containers[0].resources.requests.cpu}')
INITIAL_RESTARTS=$(kubectl get pod "${POD_NAME}" -n "${NAMESPACE}" -o jsonpath='{.status.containerStatuses[0].restartCount}')

echo "    Initial requests.cpu: ${INITIAL_CPU_REQ}"
echo "    Initial container restarts: ${INITIAL_RESTARTS}"

echo "==> 2. Patching resources in-place via --subresource=resize (zero restarts)..."
kubectl patch pod "${POD_NAME}" -n "${NAMESPACE}" --subresource=resize -p '{"spec":{"containers":[{"name":"worker","resources":{"requests":{"cpu":"25m","memory":"32Mi"},"limits":{"cpu":"100m","memory":"64Mi"}}}]}}'

sleep 2

UPDATED_CPU_REQ=$(kubectl get pod "${POD_NAME}" -n "${NAMESPACE}" -o jsonpath='{.spec.containers[0].resources.requests.cpu}')
UPDATED_CPU_LIM=$(kubectl get pod "${POD_NAME}" -n "${NAMESPACE}" -o jsonpath='{.spec.containers[0].resources.limits.cpu}')
UPDATED_RESTARTS=$(kubectl get pod "${POD_NAME}" -n "${NAMESPACE}" -o jsonpath='{.status.containerStatuses[0].restartCount}')

echo "    Updated requests.cpu: ${UPDATED_CPU_REQ}"
echo "    Updated limits.cpu:   ${UPDATED_CPU_LIM}"
echo "    Active container restarts: ${UPDATED_RESTARTS}"

if [[ "${UPDATED_CPU_REQ}" != "25m" ]]; then
  echo "    ERROR: Expected requests.cpu 25m, got ${UPDATED_CPU_REQ}"
  exit 1
fi

if [[ "${UPDATED_RESTARTS}" -ne "${INITIAL_RESTARTS}" ]]; then
  echo "    ERROR: Container restarted during in-place resize!"
  exit 1
fi

echo "==> [SUCCESS] In-place pod resource resizing verified without container restart!"
