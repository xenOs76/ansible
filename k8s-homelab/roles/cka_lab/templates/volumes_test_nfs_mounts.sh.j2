#!/usr/bin/env bash
# ==============================================================================
# CKA Volumes Practice Lab - NFS Verification Script
# Managed by Ansible (roles/cka_lab)
# ==============================================================================
set -euo pipefail

NFS_HOST="{{ cka_lab_nfs_server_hostname }}"
NFS_IP="{{ cka_lab_nfs_server_ip }}"
NFS_EXPORT="{{ cka_lab_nfs_export_dir }}"
TEST_POD="nfs-test-verifier"
TEST_NAMESPACE="default"

echo "==> [1/4] Checking DNS / Hostname resolution for ${NFS_HOST}..."
if getent hosts "${NFS_HOST}" >/dev/null 2>&1; then
  RESOLVED_IP="$(getent hosts "${NFS_HOST}" | awk '{print $1}' | head -n1)"
  echo "    OK: ${NFS_HOST} resolves to ${RESOLVED_IP} (target: ${NFS_IP})"
else
  echo "    FAIL: Cannot resolve ${NFS_HOST} via /etc/hosts or DNS" >&2
  exit 1
fi

echo "==> [2/4] Checking NFS RPC / port connectivity to ${NFS_HOST}:2049..."
if command -v nc >/dev/null 2>&1; then
  nc -z -w 3 "${NFS_HOST}" 2049 && echo "    OK: TCP 2049 reachable on ${NFS_HOST}"
elif command -v timeout >/dev/null 2>&1; then
  timeout 3 bash -c "</dev/tcp/${NFS_HOST}/2049" 2>/dev/null && echo "    OK: TCP 2049 reachable on ${NFS_HOST}"
else
  echo "    INFO: Netcat not installed, skipping TCP probe"
fi

echo "==> [3/4] Creating temporary Kubernetes Pod to test NFS inline mount..."
# Clean up any leftover test pod if it exists
if kubectl get pod "${TEST_POD}" -n "${TEST_NAMESPACE}" >/dev/null 2>&1; then
  kubectl delete pod "${TEST_POD}" -n "${TEST_NAMESPACE}" --interactive=false --wait=true >/dev/null 2>&1 || true
fi

cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: ${TEST_POD}
  namespace: ${TEST_NAMESPACE}
spec:
  restartPolicy: Never
  containers:
    - name: test-runner
      image: busybox:1.36
      command: ["sh", "-c", "echo 'NFS write check from pod' >> /mnt/nfs/shared-data.txt && sleep 30"]
      volumeMounts:
        - name: nfs-test-vol
          mountPath: /mnt/nfs
  volumes:
    - name: nfs-test-vol
      nfs:
        server: ${NFS_HOST}
        path: ${NFS_EXPORT}
EOF

echo "    Waiting for test pod ${TEST_POD} to start..."
if kubectl wait --for=condition=Ready "pod/${TEST_POD}" -n "${TEST_NAMESPACE}" --timeout=45s; then
  echo "    OK: Test Pod running with NFS volume attached!"
  READ_CONTENT="$(kubectl exec "${TEST_POD}" -n "${TEST_NAMESPACE}" -- cat /mnt/nfs/index.html | head -n 1)"
  echo "    Read content from ${NFS_HOST}:${NFS_EXPORT}/index.html:"
  echo "    ${READ_CONTENT}"
else
  echo "    FAIL: Test Pod failed to reach Ready status." >&2
  kubectl describe pod "${TEST_POD}" -n "${TEST_NAMESPACE}" >&2
  kubectl delete pod "${TEST_POD}" -n "${TEST_NAMESPACE}" --interactive=false --ignore-not-found=true >/dev/null 2>&1 || true
  exit 1
fi

echo "==> [4/4] Cleaning up test pod..."
kubectl delete pod "${TEST_POD}" -n "${TEST_NAMESPACE}" --interactive=false --wait=true >/dev/null 2>&1 || true

echo "==> All CKA NFS Volume connectivity checks PASSED successfully!"
