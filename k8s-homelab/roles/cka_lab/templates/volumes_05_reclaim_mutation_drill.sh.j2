#!/usr/bin/env bash
set -euo pipefail

# Drill: PersistentVolume ReclaimPolicy Mutation & Manual Recovery
PV_NAME="cka-reclaim-pv"
PVC_NAME="cka-reclaim-pvc"

echo "=== CKA Drill: PV ReclaimPolicy Mutation (Retain vs Delete) ==="

echo "[1/5] Creating test PV and PVC..."
kubectl apply -f - << EOF
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ${PV_NAME}
  labels:
    app.kubernetes.io/part-of: cka-lab
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Delete
  hostPath:
    path: /tmp/reclaim-test-data
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${PVC_NAME}
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 500Mi
EOF

sleep 2
echo "Initial PV Status: $(kubectl get pv ${PV_NAME} -o jsonpath='{.status.phase}')"

echo "[2/5] Mutating PV reclaimPolicy from Delete to Retain..."
kubectl patch pv "${PV_NAME}" -p '{"spec":{"persistentVolumeReclaimPolicy":"Retain"}}'

echo "Updated Reclaim Policy: $(kubectl get pv ${PV_NAME} -o jsonpath='{.spec.persistentVolumeReclaimPolicy}')"

echo "[3/5] Deleting PVC and observing Released phase..."
kubectl delete pvc "${PVC_NAME}" -n default

sleep 2
PHASE=$(kubectl get pv "${PV_NAME}" -o jsonpath='{.status.phase}')
echo "PV Phase after PVC deletion: ${PHASE} (Expected: Released)"

echo "[4/5] Reclaiming PV for reuse by removing spec.claimRef..."
kubectl patch pv "${PV_NAME}" -p '{"spec":{"claimRef": null}}'

sleep 2
RECLAIMED_PHASE=$(kubectl get pv "${PV_NAME}" -o jsonpath='{.status.phase}')
echo "PV Phase after clearing claimRef: ${RECLAIMED_PHASE} (Expected: Available)"

echo "[5/5] Cleaning up test PV..."
kubectl delete pv "${PV_NAME}"

echo "=== Reclaim Policy Mutation Drill PASSED! ==="
