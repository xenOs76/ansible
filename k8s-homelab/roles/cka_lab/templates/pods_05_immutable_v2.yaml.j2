apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-immutable-app
  namespace: {{ cka_lab_pods_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-immutable-app
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: pods
spec:
  restartPolicy: Always
  containers:
    - name: app
      image: nginx:alpine
      ports:
        - containerPort: 8080
      env:
        - name: APP_VERSION
          value: "v2"
        - name: CACHE_ENABLED
          value: "true"
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
