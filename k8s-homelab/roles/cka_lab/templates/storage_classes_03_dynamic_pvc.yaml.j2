apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: cka-lab-dynamic-pvc
  namespace: {{ cka_lab_storage_classes_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-dynamic-pvc
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: storage-classes
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: cka-lab-sc-delete-wait
  resources:
    requests:
      storage: 100Mi
