apiVersion: v1
kind: Pod
metadata:
  name: cka-secure-volume-pod
  namespace: {{ cka_lab_secrets_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets-volume-permissions
spec:
  restartPolicy: Never
  containers:
    - name: secure-reader
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - |
          echo "=== Inspecting Secret File Permissions (expected 0400 / r--------) ==="
          ls -la /etc/app-secrets
          echo "=== Reading username file ==="
          cat /etc/app-secrets/username
          echo ""
          sleep 3600
      volumeMounts:
        - name: app-secret-vol
          mountPath: /etc/app-secrets
          readOnly: true
  volumes:
    - name: app-secret-vol
      secret:
        secretName: sample-app-secret
        defaultMode: 256  # 0400 octal is 256 in decimal
