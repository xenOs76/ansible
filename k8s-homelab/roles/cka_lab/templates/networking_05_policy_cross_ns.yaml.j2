apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-frontend-portal-only
  namespace: cka-secure-db
  labels:
    app.kubernetes.io/part-of: cka-lab
spec:
  podSelector:
    matchLabels:
      role: database
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          tier: portal
      podSelector:
        matchLabels:
          role: frontend
    ports:
    - protocol: TCP
      port: 80
