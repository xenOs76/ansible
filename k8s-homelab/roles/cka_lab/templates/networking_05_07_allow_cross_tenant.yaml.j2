---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-frontend-to-db
  namespace: {{ cka_lab_networking_tenant_b | default('tenant-b') }}
  labels:
    app.kubernetes.io/name: allow-frontend-to-db
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  podSelector:
    matchLabels:
      role: database
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ cka_lab_networking_tenant_a | default('tenant-a') }}
          podSelector:
            matchLabels:
              role: frontend
      ports:
        - protocol: TCP
          port: 5432
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-db-egress
  namespace: {{ cka_lab_networking_tenant_a | default('tenant-a') }}
  labels:
    app.kubernetes.io/name: allow-db-egress
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  podSelector:
    matchLabels:
      role: frontend
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ cka_lab_networking_tenant_b | default('tenant-b') }}
          podSelector:
            matchLabels:
              role: database
      ports:
        - protocol: TCP
          port: 5432
