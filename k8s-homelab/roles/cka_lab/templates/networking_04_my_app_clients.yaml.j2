---
apiVersion: v1
kind: Pod
metadata:
  name: trusted-client
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: trusted-client
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
    app: trusted
spec:
  restartPolicy: Always
  containers:
    - name: client
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
      args:
        - while true; do sleep 3600; done
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
---
apiVersion: v1
kind: Pod
metadata:
  name: untrusted-client
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: untrusted-client
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
    app: untrusted
spec:
  restartPolicy: Always
  containers:
    - name: client
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
      args:
        - while true; do sleep 3600; done
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
