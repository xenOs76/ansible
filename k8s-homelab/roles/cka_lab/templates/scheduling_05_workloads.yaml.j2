apiVersion: v1
kind: Pod
metadata:
  name: cka-low-prio-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    tier: preemption-test
spec:
  priorityClassName: cka-low-priority
  containers:
  - name: sleeper
    image: busybox:1.36
    command: ["sleep", "3600"]
    resources:
      requests:
        cpu: 20m
        memory: 32Mi
---
apiVersion: v1
kind: Pod
metadata:
  name: cka-high-prio-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    tier: preemption-test
spec:
  priorityClassName: cka-high-priority
  containers:
  - name: server
    image: nginx:alpine
    ports:
    - containerPort: 80
    resources:
      requests:
        cpu: 20m
        memory: 32Mi
