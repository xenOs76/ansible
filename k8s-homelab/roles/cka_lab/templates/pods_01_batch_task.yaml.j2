apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-batch-task
  namespace: {{ cka_lab_pods_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-batch-task
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: pods
    tier: batch
spec:
  restartPolicy: Never
  containers:
    - name: batch-worker
      image: busybox:1.36.1
      command:
        - /bin/sh
      args:
        - -c
        - |
          echo "[cka-lab-batch-task] Initialization phase started."
          for phase in extraction transform load validation; do
            echo "[cka-lab-batch-task] Executing pipeline stage: ${phase}"
            sleep 1
          done
          echo "[cka-lab-batch-task] All stages completed successfully."
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
