apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: cka-lab-httproute-tls
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-httproute-tls
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  parentRefs:
    - name: cka-lab-gateway
      namespace: {{ cka_lab_helm_ngf_namespace | default('nginx-gateway') }}
      sectionName: https-terminate
  hostnames:
    - "{{ cka_lab_networking_gateway_secure_domain | default('secure-gateway.example.local') }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /secure-api
      backendRefs:
        - name: cka-lab-ingress-api-svc
          port: 80
    - matches:
        - path:
            type: PathPrefix
            value: /secure-web
      backendRefs:
        - name: cka-lab-ingress-web-svc
          port: 80
