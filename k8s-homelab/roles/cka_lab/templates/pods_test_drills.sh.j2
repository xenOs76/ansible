#!/usr/bin/env bash
# ==============================================================================
# test-pods-drills.sh: Automated Validation Suite for CKA Pods & Namespaces
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAMESPACE="{{ cka_lab_pods_namespace | default('default') }}"
STAGING_NS="{{ cka_lab_pods_staging_namespace | default('cka-lab-staging') }}"

echo "===================================================================="
echo "  [CKA LAB] Running End-to-End Pods & Namespaces Drill Verification "
echo "===================================================================="

# Helper cleanup function
cleanup() {
  echo "==> Cleaning up test resources..."
  kubectl delete pod cka-lab-web-service cka-lab-batch-task cka-lab-finite-worker \
    cka-lab-failing-worker cka-lab-telemetry-app cka-lab-echo-server \
    cka-lab-immutable-app -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete namespace "${STAGING_NS}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl config set-context --current --namespace="${NAMESPACE}" >/dev/null 2>&1 || true
}

trap cleanup EXIT

# ------------------------------------------------------------------------------
# Test 1: Imperative & Declarative Pod Creation
# ------------------------------------------------------------------------------
echo "==> [1/7] Testing Imperative and Declarative Pod Creation..."
kubectl run cka-lab-web-service \
  --image=nginx:alpine \
  --port=80 \
  --env="APP_ENV=production" \
  --env="LOG_LEVEL=info" \
  --labels="tier=frontend,app=cka-lab-web-service" \
  -n "${NAMESPACE}"

echo "Waiting for cka-lab-web-service to be Ready..."
kubectl wait --for=condition=Ready pod/cka-lab-web-service -n "${NAMESPACE}" --timeout=60s

kubectl apply -f "${SCRIPT_DIR}/01-imperative-declarative/cka-lab-batch-task-pod.yaml" -n "${NAMESPACE}"
echo "Waiting for cka-lab-batch-task to complete..."
# Wait up to 30s for the batch task
for _ in {1..30}; do
  PHASE=$(kubectl get pod cka-lab-batch-task -n "${NAMESPACE}" -o jsonpath='{.status.phase}' 2>/dev/null || echo "")
  if [ "${PHASE}" = "Succeeded" ]; then
    echo "cka-lab-batch-task completed successfully."
    break
  fi
  sleep 1
done

# ------------------------------------------------------------------------------
# Test 2: Lifecycle Phases & Restart Policies
# ------------------------------------------------------------------------------
echo "==> [2/7] Testing Lifecycle Phases & Restart Policies..."
kubectl apply -f "${SCRIPT_DIR}/02-lifecycle-and-restarts/cka-lab-finite-worker-pod.yaml" -n "${NAMESPACE}"
for _ in {1..30}; do
  PHASE=$(kubectl get pod cka-lab-finite-worker -n "${NAMESPACE}" -o jsonpath='{.status.phase}' 2>/dev/null || echo "")
  if [ "${PHASE}" = "Succeeded" ]; then
    echo "cka-lab-finite-worker reached Succeeded phase as expected."
    break
  fi
  sleep 1
done

# ------------------------------------------------------------------------------
# Test 3: Container Observability & Diagnostics
# ------------------------------------------------------------------------------
echo "==> [3/7] Testing Container Observability (Logs & Exec)..."
kubectl apply -f "${SCRIPT_DIR}/03-observability-exec/cka-lab-telemetry-pod.yaml" -n "${NAMESPACE}"
kubectl wait --for=condition=Ready pod/cka-lab-telemetry-app -n "${NAMESPACE}" --timeout=60s

LOG_SAMPLE=$(kubectl logs cka-lab-telemetry-app -n "${NAMESPACE}" --tail=5)
echo "Retrieved log sample: ${LOG_SAMPLE}"

EXEC_ENV=$(kubectl exec cka-lab-telemetry-app -n "${NAMESPACE}" -- env | grep -E "APP_ROLE|PATH" | head -n 1)
echo "Retrieved container environment via exec: ${EXEC_ENV}"

# ------------------------------------------------------------------------------
# Test 4: Ephemeral Troubleshooting Pods & Cluster IP Networking
# ------------------------------------------------------------------------------
echo "==> [4/7] Testing Ephemeral Troubleshooting Pod & Networking..."
kubectl apply -f "${SCRIPT_DIR}/04-ephemeral-networking/cka-lab-echo-server-pod.yaml" -n "${NAMESPACE}"
kubectl wait --for=condition=Ready pod/cka-lab-echo-server -n "${NAMESPACE}" --timeout=60s

ECHO_IP=$(kubectl get pod cka-lab-echo-server -n "${NAMESPACE}" -o jsonpath='{.status.podIP}')
echo "Target server IP: ${ECHO_IP}"

echo "Launching ephemeral probe to test HTTP reachability..."
HTTP_RESPONSE=$(kubectl run cka-lab-ephemeral-probe \
  --image=busybox:1.36.1 \
  --rm -i --restart=Never \
  -n "${NAMESPACE}" \
  -- wget -qO- "http://${ECHO_IP}:80" || true)

if echo "${HTTP_RESPONSE}" | grep -q -i "nginx"; then
  echo "Probe successfully received HTTP response from cka-lab-echo-server."
else
  echo "Probe received response: ${HTTP_RESPONSE:0:100}..."
fi

# ------------------------------------------------------------------------------
# Test 5: Pod Spec Immutability & Force Replacement
# ------------------------------------------------------------------------------
echo "==> [5/7] Testing Pod Spec Immutability & Force Replacement..."
kubectl apply -f "${SCRIPT_DIR}/05-spec-immutability/cka-lab-immutable-app-v1.yaml" -n "${NAMESPACE}"
kubectl wait --for=condition=Ready pod/cka-lab-immutable-app -n "${NAMESPACE}" --timeout=60s

# Force replace with v2 manifest
echo "Executing kubectl replace --force with v2 manifest..."
kubectl replace --force -f "${SCRIPT_DIR}/05-spec-immutability/cka-lab-immutable-app-v2.yaml" -n "${NAMESPACE}"
kubectl wait --for=condition=Ready pod/cka-lab-immutable-app -n "${NAMESPACE}" --timeout=60s

V2_VERSION=$(kubectl get pod cka-lab-immutable-app -n "${NAMESPACE}" -o jsonpath='{.spec.containers[0].env[?(@.name=="APP_VERSION")].value}')
echo "Verified updated spec container version: ${V2_VERSION}"

# ------------------------------------------------------------------------------
# Test 6: Namespaces & Context Preferences
# ------------------------------------------------------------------------------
echo "==> [6/7] Testing Namespaces and Context Preferences..."
kubectl apply -f "${SCRIPT_DIR}/06-namespaces-context/cka-lab-namespace.yaml"
kubectl get namespace "${STAGING_NS}"

# Deploy workload into staging namespace
kubectl run cka-lab-staging-worker \
  --image=busybox:1.36.1 \
  --namespace="${STAGING_NS}" \
  -- /bin/sh -c 'sleep 3600'

kubectl wait --for=condition=Ready "pod/cka-lab-staging-worker" -n "${STAGING_NS}" --timeout=60s

# Set current context preference to staging namespace
kubectl config set-context --current --namespace="${STAGING_NS}"
CURRENT_NS=$(kubectl config view --minify -o jsonpath='{.contexts[0].context.namespace}')
echo "Current active kubeconfig namespace: ${CURRENT_NS}"

# Query without explicit -n flag
MATCHING_PODS=$(kubectl get pods -o jsonpath='{.items[*].metadata.name}')
echo "Pods found in default query context: ${MATCHING_PODS}"

# Reset back to default namespace
kubectl config set-context --current --namespace="${NAMESPACE}"
echo "Context namespace reset to default."

# ------------------------------------------------------------------------------
# Test 7: Cascading Namespace Deletion
# ------------------------------------------------------------------------------
echo "==> [7/7] Testing Cascading Namespace Deletion..."
kubectl delete namespace "${STAGING_NS}" --interactive=false
echo "Namespace ${STAGING_NS} and its workloads deleted."

echo "===================================================================="
echo "  [SUCCESS] All CKA Pods & Namespaces drills verified successfully! "
echo "===================================================================="
