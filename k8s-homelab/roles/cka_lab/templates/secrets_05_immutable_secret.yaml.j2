apiVersion: v1
kind: Secret
metadata:
  name: cka-immutable-secret
  namespace: {{ cka_lab_secrets_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets-immutable
type: Opaque
immutable: true
stringData:
  api_key: "immutable-secret-api-token-value"
  jwt_signing_key: "never-change-this-signing-secret"
