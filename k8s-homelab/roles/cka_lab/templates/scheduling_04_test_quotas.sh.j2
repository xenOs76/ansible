#!/usr/bin/env bash
# ==============================================================================
# test-quotas.sh: Non-Interactive Verification of ResourceQuota and LimitRange
# ==============================================================================
set -euo pipefail

CAPACITY_NS="{{ cka_lab_scheduling_capacity_namespace | default('cka-lab-capacity-ns') }}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cleanup() {
  echo "==> Cleaning up capacity management test resources..."
  kubectl delete namespace "${CAPACITY_NS}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
}

trap cleanup EXIT

echo "1. Applying capacity namespace, ResourceQuota, and LimitRange..."
kubectl apply -f "${SCRIPT_DIR}/cka-lab-quota-ns.yaml"
kubectl apply -f "${SCRIPT_DIR}/cka-lab-compute-quota.yaml"
kubectl apply -f "${SCRIPT_DIR}/cka-lab-limit-range.yaml"

echo "2. Deploying unconstrained Pod to test LimitRange default injection..."
kubectl run cka-lab-auto-limit-pod \
  --image=busybox:1.36.1 \
  --restart=Never \
  -n "${CAPACITY_NS}" \
  -- /bin/sh -c "sleep 3600"

kubectl wait --for=condition=Ready pod/cka-lab-auto-limit-pod -n "${CAPACITY_NS}" --timeout=30s

INJECTED_CPU_REQ=$(kubectl get pod cka-lab-auto-limit-pod -n "${CAPACITY_NS}" -o jsonpath='{.spec.containers[0].resources.requests.cpu}')
INJECTED_CPU_LIM=$(kubectl get pod cka-lab-auto-limit-pod -n "${CAPACITY_NS}" -o jsonpath='{.spec.containers[0].resources.limits.cpu}')

echo "    LimitRange automatically injected:"
echo "      requests.cpu: ${INJECTED_CPU_REQ}"
echo "      limits.cpu:   ${INJECTED_CPU_LIM}"

if [[ "${INJECTED_CPU_REQ}" != "50m" ]]; then
  echo "    ERROR: Expected injected request 50m, got ${INJECTED_CPU_REQ}"
  exit 1
fi

echo "3. Testing LimitRange max rejection on oversized pod (expect REJECTION)..."
cat <<'EOF' > /tmp/cka-lab-oversized-pod.yaml
apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-oversized-pod
spec:
  containers:
    - name: worker
      image: busybox:1.36.1
      command: ["/bin/sh", "-c", "sleep 3600"]
      resources:
        limits:
          cpu: 500m
EOF

if kubectl apply -f /tmp/cka-lab-oversized-pod.yaml -n "${CAPACITY_NS}" >/dev/null 2>&1; then
  echo "    ERROR: Oversized pod was accepted when LimitRange max is 250m!"
  rm -f /tmp/cka-lab-oversized-pod.yaml
  exit 1
else
  echo "    OK: Admission controller rejected oversized pod exceeding LimitRange max."
  rm -f /tmp/cka-lab-oversized-pod.yaml
fi

echo "4. Inspecting ResourceQuota consumption:"
kubectl get resourcequota cka-lab-compute-quota -n "${CAPACITY_NS}"

echo "==> Capacity governance drill verified successfully."
