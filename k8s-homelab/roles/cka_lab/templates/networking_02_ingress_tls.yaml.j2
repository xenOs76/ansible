apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: cka-lab-ingress-tls
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-ingress-tls
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
    nginx.org/rewrites: "serviceName=cka-lab-ingress-web-svc rewrite=/;serviceName=cka-lab-ingress-api-svc rewrite=/"
spec:
  ingressClassName: cilium
  tls:
    - hosts:
        - {{ cka_lab_networking_secure_domain | default('secure-ingress.example.local') }}
      secretName: cka-lab-ingress-tls
  rules:
    - host: {{ cka_lab_networking_secure_domain | default('secure-ingress.example.local') }}
      http:
        paths:
          - path: /web
            pathType: Prefix
            backend:
              service:
                name: cka-lab-ingress-web-svc
                port:
                  number: 80
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: cka-lab-ingress-api-svc
                port:
                  number: 80
