apiVersion: v1
kind: Pod
metadata:
  name: cka-bulk-envfrom-pod
  namespace: {{ cka_lab_configmaps_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: configmaps-envfrom
spec:
  restartPolicy: Never
  containers:
    - name: consumer
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - |
          echo "=== Bulk Environment Variables (ConfigMap with prefix CFG_) ==="
          env | grep "^CFG_" || true
          echo "=== Bulk Environment Variables (Secret with prefix SEC_) ==="
          env | grep "^SEC_" || true
          sleep 3600
      envFrom:
        - prefix: CFG_
          configMapRef:
            name: sample-app-config
        - prefix: SEC_
          secretRef:
            name: sample-app-secret
