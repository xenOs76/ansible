apiVersion: v1
kind: Namespace
metadata:
  name: cka-rbac-sa-test
  labels:
    app.kubernetes.io/part-of: cka-lab
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: deploy-bot
  namespace: cka-rbac-sa-test
  labels:
    app.kubernetes.io/part-of: cka-lab
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: pod-reader
  namespace: cka-rbac-sa-test
  labels:
    app.kubernetes.io/part-of: cka-lab
rules:
- apiGroups: [""]
  resources: ["pods", "pods/log"]
  verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: read-pods-binding
  namespace: cka-rbac-sa-test
  labels:
    app.kubernetes.io/part-of: cka-lab
subjects:
- kind: ServiceAccount
  name: deploy-bot
  namespace: cka-rbac-sa-test
roleRef:
  kind: Role
  name: pod-reader
  apiGroup: rbac.authorization.k8s.io
