apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-intolerant-pod
  namespace: {{ cka_lab_scheduling_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-intolerant-pod
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: scheduling
spec:
  containers:
    - name: worker
      image: busybox:1.36.1
      command: ["/bin/sh", "-c", "sleep 3600"]
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
