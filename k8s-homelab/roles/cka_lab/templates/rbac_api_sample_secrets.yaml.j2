---
# ==============================================================================
# In-Pod API Server Interrogation: Target Secret & ConfigMap
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: {{ cka_lab_api_access_namespace | default('finance-secure') }}
type: Opaque
stringData:
  database.url: "postgres://db.priv.os76.xyz:5432/finance"
  api.token: "sample-dummy-api-token-test-value"  # gitleaks:allow
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: app-settings
  namespace: {{ cka_lab_api_access_namespace | default('finance-secure') }}
data:
  LOG_LEVEL: "info"
  CACHE_ENABLED: "true"
