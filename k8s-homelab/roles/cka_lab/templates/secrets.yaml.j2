---
# ==============================================================================
# CKA Training Lab: Namespaces & Sample Secrets Manifest
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/
# ==============================================================================

# Ensure development namespace exists
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cka_lab_secrets_dev_namespace }}
  labels:
    environment: {{ cka_lab_secrets_dev_namespace }}
    app.kubernetes.io/part-of: cka-lab
---
# ==============================================================================
# Secrets in Namespace: {{ cka_lab_secrets_default_namespace }}
# ==============================================================================

# 1. Opaque Secret (Generic arbitrary user-defined data)
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#opaque-secrets
apiVersion: v1
kind: Secret
metadata:
  name: sample-app-secret
  namespace: {{ cka_lab_secrets_default_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
type: Opaque
stringData:
  username: {{ cka_lab_secret_opaque_username }}
  password: {{ cka_lab_secret_opaque_password }}
  database-url: {{ cka_lab_secret_opaque_db_url }}
  api-key: {{ cka_lab_secret_opaque_api_key }}
---
# 2. Basic Authentication Secret
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#basic-authentication-secret
apiVersion: v1
kind: Secret
metadata:
  name: sample-basic-auth
  namespace: {{ cka_lab_secrets_default_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
type: kubernetes.io/basic-auth
stringData:
  username: {{ cka_lab_secret_basic_username }}
  password: {{ cka_lab_secret_basic_password }}
---
# 3. TLS Secret (Certificate and private key)
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#tls-secrets
apiVersion: v1
kind: Secret
metadata:
  name: sample-tls-secret
  namespace: {{ cka_lab_secrets_default_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
type: kubernetes.io/tls
data:
  tls.crt: {{ cka_lab_sample_tls_crt_raw.content | trim }}
  tls.key: {{ cka_lab_sample_tls_key_raw.content | trim }}
---
# 4. SSH Authentication Secret
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#ssh-authentication-secrets
apiVersion: v1
kind: Secret
metadata:
  name: sample-ssh-auth
  namespace: {{ cka_lab_secrets_default_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
type: kubernetes.io/ssh-auth
data:
  ssh-privatekey: {{ cka_lab_sample_ssh_key_raw.content | trim }}
---
# ==============================================================================
# Secrets in Namespace: {{ cka_lab_secrets_dev_namespace }}
# ==============================================================================

# 1. Opaque Secret (Development application credentials)
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#opaque-secrets
apiVersion: v1
kind: Secret
metadata:
  name: dev-app-secret
  namespace: {{ cka_lab_secrets_dev_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
    environment: {{ cka_lab_secrets_dev_namespace }}
type: Opaque
stringData:
  username: {{ cka_lab_dev_secret_opaque_username }}
  password: {{ cka_lab_dev_secret_opaque_password }}
  database-url: {{ cka_lab_dev_secret_opaque_db_url }}
  api-key: {{ cka_lab_dev_secret_opaque_api_key }}
  jwt-secret: {{ cka_lab_dev_secret_opaque_jwt }}
---
# 2. Basic Authentication Secret (Development API service)
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#basic-authentication-secret
apiVersion: v1
kind: Secret
metadata:
  name: dev-basic-auth
  namespace: {{ cka_lab_secrets_dev_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
    environment: {{ cka_lab_secrets_dev_namespace }}
type: kubernetes.io/basic-auth
stringData:
  username: {{ cka_lab_dev_secret_basic_username }}
  password: {{ cka_lab_dev_secret_basic_password }}
---
# 3. TLS Secret (Development ingress/service TLS)
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#tls-secrets
apiVersion: v1
kind: Secret
metadata:
  name: dev-tls-secret
  namespace: {{ cka_lab_secrets_dev_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
    environment: {{ cka_lab_secrets_dev_namespace }}
type: kubernetes.io/tls
data:
  tls.crt: {{ cka_lab_dev_tls_crt_raw.content | trim }}
  tls.key: {{ cka_lab_dev_tls_key_raw.content | trim }}
---
# 4. SSH Authentication Secret (Development deploy key)
# Reference: https://kubernetes.io/docs/concepts/configuration/secret/#ssh-authentication-secrets
apiVersion: v1
kind: Secret
metadata:
  name: dev-ssh-auth
  namespace: {{ cka_lab_secrets_dev_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets
    environment: {{ cka_lab_secrets_dev_namespace }}
type: kubernetes.io/ssh-auth
data:
  ssh-privatekey: {{ cka_lab_dev_ssh_key_raw.content | trim }}
