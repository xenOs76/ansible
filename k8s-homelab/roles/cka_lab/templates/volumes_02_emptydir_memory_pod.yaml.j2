apiVersion: v1
kind: Pod
metadata:
  name: emptydir-memory-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-emptydir
spec:
  containers:
    - name: cache-service
      image: busybox:1.36
      command: ["sh", "-c", "echo 'In-memory cache initialized' > /dev/shm/cache/cache.dat && sleep 3600"]
      resources:
        limits:
          memory: 128Mi
        requests:
          memory: 64Mi
      volumeMounts:
        - name: ram-cache
          mountPath: /dev/shm/cache
  volumes:
    - name: ram-cache
      emptyDir:
        medium: Memory
        sizeLimit: 64Mi
