---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: iscsi-static-pv
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: iscsi-volumes
    storage-tier: iscsi
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  volumeMode: Filesystem
  storageClassName: ""
  iscsi:
    targetPortal: "{{ cka_lab_iscsi_portal }}"
    iqn: "{{ cka_lab_iscsi_iqn }}"
    lun: {{ cka_lab_iscsi_fs_lun | default(1) }}
    fsType: ext4
    readOnly: false
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: iscsi-claim
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: iscsi-volumes
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Filesystem
  storageClassName: ""
  resources:
    requests:
      storage: 500Mi
  volumeName: iscsi-static-pv
---
apiVersion: v1
kind: Pod
metadata:
  name: iscsi-pvc-consumer-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: iscsi-volumes
spec:
  containers:
    - name: web-app
      image: alpine:latest
      command: ["/bin/sh", "-c"]
      args:
        - |
          echo "Writing test index to mounted iSCSI PVC..."
          echo "Serving from iSCSI volume at $(date)" > /mnt/storage/index.txt
          sync
          tail -f /dev/null
      volumeMounts:
        - name: iscsi-storage
          mountPath: /mnt/storage
  volumes:
    - name: iscsi-storage
      persistentVolumeClaim:
        claimName: iscsi-claim
