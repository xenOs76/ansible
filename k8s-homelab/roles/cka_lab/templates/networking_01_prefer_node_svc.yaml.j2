apiVersion: v1
kind: Service
metadata:
  name: cka-lab-traffic-distribution-svc
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-traffic-distribution-svc
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  type: ClusterIP
  trafficDistribution: PreferSameNode
  selector:
    app: cka-lab-backend-app
  ports:
    - name: http-web
      port: 80
      targetPort: http-web
      protocol: TCP
