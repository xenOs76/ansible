apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: cephfs-dynamic-claim
  namespace: {{ cka_lab_storage_classes_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: ceph-volumes
spec:
  accessModes:
    - ReadWriteMany
  storageClassName: {{ cka_lab_cephfs_storage_class | default('rook-cephfs') }}
  resources:
    requests:
      storage: 500Mi
