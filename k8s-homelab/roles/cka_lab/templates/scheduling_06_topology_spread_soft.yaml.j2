---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: topology-spread-soft
  namespace: default
  labels:
    app: topology-spread-soft
    cka-drill: scheduling-topology-spread
spec:
  replicas: 4
  selector:
    matchLabels:
      app: topology-spread-soft
  template:
    metadata:
      labels:
        app: topology-spread-soft
    spec:
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app: topology-spread-soft
      containers:
        - name: pause-workload
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
