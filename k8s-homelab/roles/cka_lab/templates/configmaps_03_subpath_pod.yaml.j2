apiVersion: v1
kind: Pod
metadata:
  name: cka-subpath-pod
  namespace: {{ cka_lab_configmaps_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: configmaps-subpath
spec:
  restartPolicy: Never
  containers:
    - name: web
      image: nginx:alpine
      ports:
        - containerPort: 80
      volumeMounts:
        # Injects single file into /etc/nginx/conf.d/ without obliterating neighboring directory files
        - name: nginx-config-vol
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: nginx.conf
          readOnly: true
  volumes:
    - name: nginx-config-vol
      configMap:
        name: sample-service-config
