apiVersion: batch/v1
kind: Job
metadata:
  name: cka-lab-parallel-job
  namespace: {{ cka_lab_workloads_advanced_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-parallel-job
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: workloads-advanced
spec:
  completions: 4
  parallelism: 2
  backoffLimit: 3
  template:
    metadata:
      labels:
        app: cka-lab-parallel-task
        cka.practice/scenario: workloads-advanced
    spec:
      restartPolicy: Never
      containers:
        - name: worker
          image: busybox:1.36.1
          command:
            - /bin/sh
            - -c
            - "echo 'Processing batch item...' && sleep 2 && echo 'Batch item complete.'"
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
