#!/usr/bin/env bash
# ==============================================================================
# decode-secrets.sh: Rapid payload decoding and inspection techniques
# ==============================================================================
set -euo pipefail

TARGET_NS="{{ cka_lab_secrets_default_namespace | default('default') }}"
SECRET_NAME="sample-app-secret"

echo "===================================================================="
echo "  [CKA LAB] Drill 2: Base64 Inspection & Fast Decoding Techniques   "
echo "===================================================================="
echo "Target secret: ${TARGET_NS}/${SECRET_NAME}"

echo "==> 1. Raw Base64 data from API server:"
kubectl get secret "${SECRET_NAME}" -n "${TARGET_NS}" -o jsonpath='{.data}'
echo ""
echo ""

echo "==> 2. Fast single-key decoding via JSONPath & base64 -d:"
echo -n "Decoded username: "
kubectl get secret "${SECRET_NAME}" -n "${TARGET_NS}" -o jsonpath='{.data.username}' | base64 -d
echo ""
echo -n "Decoded password: "
kubectl get secret "${SECRET_NAME}" -n "${TARGET_NS}" -o jsonpath='{.data.password}' | base64 -d
echo ""
echo -n "Decoded database-url: "
kubectl get secret "${SECRET_NAME}" -n "${TARGET_NS}" -o jsonpath='{.data.database-url}' | base64 -d
echo ""
echo ""

echo "==> 3. Mass decoding of all keys using Go template (no manual loop needed):"
# shellcheck disable=SC2016
kubectl get secret "${SECRET_NAME}" -n "${TARGET_NS}" \
  -o go-template='{% raw %}{{range $k,$v := .data}}{{$k}}: {{$v | base64decode}}{{"\n"}}{{end}}{% endraw %}'
echo ""

echo "==> Fast decoding drills completed successfully."
