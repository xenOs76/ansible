# ==============================================================================
# CKA Strategy Drill: Zero-Downtime Rolling Update
# ==============================================================================
# Guarantees that available capacity NEVER drops below desired replica count
# by setting 'maxUnavailable: 0' and 'maxSurge: 1'.
# At all times during rollout, at least 3 pods are serving traffic.
# ==============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cka-lab-mission-critical
  namespace: {{ cka_lab_deployments_namespace | default('default') }}
  labels:
    app: cka-lab-mission-critical
spec:
  replicas: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: cka-lab-mission-critical
  template:
    metadata:
      labels:
        app: cka-lab-mission-critical
    spec:
      containers:
        - name: service
          image: nginx:1.25-alpine
          ports:
            - containerPort: 80
