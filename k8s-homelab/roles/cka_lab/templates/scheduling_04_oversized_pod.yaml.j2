apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-oversized-pod
  namespace: {{ cka_lab_scheduling_capacity_namespace | default('cka-lab-capacity-ns') }}
  labels:
    app.kubernetes.io/name: cka-lab-oversized-pod
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: scheduling
spec:
  restartPolicy: Never
  containers:
    - name: worker
      image: busybox:1.36.1
      command: ["/bin/sh", "-c", "sleep 3600"]
      resources:
        limits:
          cpu: 500m
