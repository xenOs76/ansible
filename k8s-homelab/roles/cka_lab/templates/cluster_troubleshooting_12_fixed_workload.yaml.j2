---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cka-gpu-processor
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    app: gpu-processor
spec:
  replicas: 2
  selector:
    matchLabels:
      app: gpu-processor
  template:
    metadata:
      labels:
        app: gpu-processor
        app.kubernetes.io/part-of: cka-lab
    spec:
      # Corrected: 'sku' matches node taint 'sku=gpu:NoSchedule'
      tolerations:
        - key: "sku"
          operator: "Equal"
          value: "gpu"
          effect: "NoSchedule"
      containers:
        - name: processor
          image: busybox:1.36
          command:
            - sh
            - -c
            - "echo 'GPU Worker processing...' && sleep 3600"
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
