apiVersion: v1
kind: Pod
metadata:
  name: cka-single-env-pod
  namespace: {{ cka_lab_configmaps_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: configmaps-env
spec:
  restartPolicy: Never
  containers:
    - name: consumer
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - |
          echo "CONTAINER_ENV: ${CONTAINER_ENV}"
          echo "HTTP_PORT: ${HTTP_PORT}"
          echo "DB_USER: ${DB_USER}"
          echo "DB_URL: ${DB_URL}"
          sleep 3600
      env:
        - name: CONTAINER_ENV
          valueFrom:
            configMapKeyRef:
              name: sample-app-config
              key: APP_ENV
        - name: HTTP_PORT
          valueFrom:
            configMapKeyRef:
              name: sample-app-config
              key: SERVER_PORT
        - name: DB_USER
          valueFrom:
            secretKeyRef:
              name: sample-app-secret
              key: username
        - name: DB_URL
          valueFrom:
            secretKeyRef:
              name: sample-app-secret
              key: database-url
