apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-init-pod
  namespace: {{ cka_lab_workloads_advanced_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-init-pod
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: workloads-advanced
spec:
  initContainers:
    - name: data-initializer
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - "echo 'Initializing application assets...' && echo 'CONFIG_READY=true' > /work-dir/app.env"
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
      volumeMounts:
        - name: shared-data
          mountPath: /work-dir
  containers:
    - name: main-app
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - "cat /work-dir/app.env && sleep 3600"
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
      volumeMounts:
        - name: shared-data
          mountPath: /work-dir
  volumes:
    - name: shared-data
      emptyDir: {}
