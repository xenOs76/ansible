---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: fc-static-pv
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
    storage-tier: fc-san
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  volumeMode: Filesystem
  storageClassName: "{{ cka_lab_fc_storage_class | default('fc-manual') }}"
  fc:
    targetWWNs:
      - "{{ cka_lab_fc_target_wwns[0] }}"
    lun: {{ cka_lab_fc_fs_lun | default(0) }}
    fsType: ext4
    readOnly: false
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: fc-claim
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Filesystem
  storageClassName: "{{ cka_lab_fc_storage_class | default('fc-manual') }}"
  resources:
    requests:
      storage: 500Mi
  volumeName: fc-static-pv
---
apiVersion: v1
kind: Pod
metadata:
  name: fc-pvc-consumer-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
spec:
  containers:
    - name: web-app
      image: alpine:latest
      command: ["/bin/sh", "-c"]
      args:
        - |
          echo "Writing test record to mounted FC SAN PVC..."
          echo "Serving from Fibre Channel SAN volume at $(date)" > /mnt/storage/san-data.txt
          sync
          while true; do sleep 3600; done
      volumeMounts:
        - name: fc-storage
          mountPath: /mnt/storage
  volumes:
    - name: fc-storage
      persistentVolumeClaim:
        claimName: fc-claim
