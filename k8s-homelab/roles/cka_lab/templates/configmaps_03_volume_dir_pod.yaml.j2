apiVersion: v1
kind: Pod
metadata:
  name: cka-volume-dir-pod
  namespace: {{ cka_lab_configmaps_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: configmaps-volumedir
spec:
  restartPolicy: Never
  containers:
    - name: reader
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - |
          echo "=== Mounted ConfigMap Directory (/etc/sample-config) ==="
          ls -la /etc/sample-config
          echo "=== Content of application.properties ==="
          cat /etc/sample-config/application.properties
          sleep 3600
      volumeMounts:
        - name: service-config-volume
          mountPath: /etc/sample-config
          readOnly: true
  volumes:
    - name: service-config-volume
      configMap:
        name: sample-service-config
        defaultMode: 420  # 0644 in octal is 420 in decimal
