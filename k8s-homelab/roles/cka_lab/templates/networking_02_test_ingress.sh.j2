#!/usr/bin/env bash
# ==============================================================================
# test-ingress.sh: Non-Interactive Verification of Ingresses
# ==============================================================================
set -euo pipefail

NAMESPACE="{{ cka_lab_networking_namespace | default('default') }}"
DOMAIN="{{ cka_lab_networking_domain | default('cka-lab.example.local') }}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INGRESS_HTTP_PORT="{{ cka_lab_networking_ingress_http_port | default(31080) }}"

echo "==> [Ingress Drill] Checking Ingress controller prerequisites..."
if ! kubectl get ingressclass cilium >/dev/null 2>&1 && ! kubectl get ingressclass nginx >/dev/null 2>&1; then
  echo "    Notice: Neither 'cilium' nor 'nginx' IngressClass is registered."
  echo "    Please enable Cilium Ingress controller:"
  echo "      /home/vagrant/cni-enable-ingress-gateway.sh"
  echo "    (Or deploy deprecated Ingress-NGINX via /home/vagrant/cka/helm/install-deprecated-nginx-ingress.sh)."
fi

echo "==> [Ingress Drill] Deploying Ingress backends and routing rules..."
kubectl apply -f "${SCRIPT_DIR}/cka-lab-ingress-backends.yaml" -n "${NAMESPACE}"
kubectl apply -f "${SCRIPT_DIR}/cka-lab-ingress.yaml" -n "${NAMESPACE}"

echo "Waiting for backend deployments to become ready..."
kubectl rollout status deployment/cka-lab-ingress-web -n "${NAMESPACE}" --timeout=60s
kubectl rollout status deployment/cka-lab-ingress-api -n "${NAMESPACE}" --timeout=60s

echo "==> Ingress resource details:"
kubectl get ingress cka-lab-ingress -n "${NAMESPACE}"

NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')

# Detect dynamically allocated NodePort if cilium-ingress service was customized
if kubectl get svc -n kube-system cilium-ingress >/dev/null 2>&1; then
  DETECTED_PORT=$(kubectl get svc -n kube-system cilium-ingress -o jsonpath='{.spec.ports[?(@.port==80)].nodePort}' 2>/dev/null || echo "")
  if [ -n "${DETECTED_PORT:-}" ] && [ "${DETECTED_PORT}" != "null" ]; then
    INGRESS_HTTP_PORT="${DETECTED_PORT}"
  fi
fi

echo "==> Testing Ingress path routing via NodePort ${INGRESS_HTTP_PORT} with Host header ${DOMAIN}..."
WEB_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -H "Host: ${DOMAIN}" "http://${NODE_IP}:${INGRESS_HTTP_PORT}/web" || echo "000")
echo "HTTP response code for /web: ${WEB_STATUS}"

API_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -H "Host: ${DOMAIN}" "http://${NODE_IP}:${INGRESS_HTTP_PORT}/api" || echo "000")
echo "HTTP response code for /api: ${API_STATUS}"

echo "==> Ingress drill verification complete."
