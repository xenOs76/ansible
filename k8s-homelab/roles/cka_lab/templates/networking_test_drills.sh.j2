#!/usr/bin/env bash
# ==============================================================================
# test-networking-drills.sh: Automated Verification Suite for CKA Networking Drills
# Modules: Services, Headless, Ingress, and Gateway API
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAMESPACE="{{ cka_lab_networking_namespace | default('default') }}"
GW_NAMESPACE="{{ cka_lab_helm_ngf_namespace | default('nginx-gateway') }}"

echo "===================================================================="
echo "  [CKA LAB] Running End-to-End Networking Verification              "
echo "===================================================================="

# Helper cleanup function (strictly non-interactive)
cleanup() {
  echo "==> Cleaning up networking test resources..."
  # Clean up services & deployments in default namespace
  kubectl delete deployment cka-lab-backend-app cka-lab-ingress-web cka-lab-ingress-api \
    my-app-deployment cache-deployment my-web-app-deployment \
    -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete pod trusted-client untrusted-client \
    -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete statefulset cka-headless-app -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete service cka-lab-clusterip-svc cka-lab-nodeport-svc cka-headless-svc cka-lab-ingress-web-svc \
    cka-lab-ingress-api-svc my-app-service cache-service my-web-app-service \
    -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete ingress cka-lab-ingress -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete networkpolicy my-app-network-policy -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete httproute cka-lab-httproute cka-lab-httproute-advanced -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete tlsroute cka-lab-tlsroute -n "${NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete gateway cka-lab-gateway -n "${GW_NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  kubectl delete secret cka-lab-gateway-tls -n "${GW_NAMESPACE}" --ignore-not-found=true --interactive=false --now >/dev/null 2>&1 || true
  CLIENT_NS="{{ cka_lab_networking_client_namespace | default('cka-lab-net-client') }}"
  BACKEND_NS="{{ cka_lab_networking_backend_namespace | default('cka-lab-net-backend') }}"
  kubectl delete namespace "${CLIENT_NS}" "${BACKEND_NS}" --ignore-not-found=true --now >/dev/null 2>&1 || true
}

trap cleanup EXIT

# ------------------------------------------------------------------------------
# Drill 1: Services & CoreDNS
# ------------------------------------------------------------------------------
echo "--------------------------------------------------------------------"
echo "  [1/5] Testing Services & CoreDNS                                  "
echo "--------------------------------------------------------------------"
echo "==> Running CoreDNS & Baseline Services Drill..."
"${SCRIPT_DIR}/01-services/test-services.sh"

echo "==> Running my-web-app NodePort Service Drill (port 30770)..."
"${SCRIPT_DIR}/01-services/test-my-web-app-service.sh"

# ------------------------------------------------------------------------------
# Drill 2: Headless Service
# ------------------------------------------------------------------------------
echo "--------------------------------------------------------------------"
echo "  [2/5] Testing Headless Service & SRV/A-Record DNS                 "
echo "--------------------------------------------------------------------"
"${SCRIPT_DIR}/01-services/test-headless.sh"

# ------------------------------------------------------------------------------
# Drill 3: Ingress Path Routing
# ------------------------------------------------------------------------------
echo "--------------------------------------------------------------------"
echo "  [3/5] Testing Ingress Path Routing                                "
echo "--------------------------------------------------------------------"
"${SCRIPT_DIR}/02-ingresses/test-ingress.sh"

# ------------------------------------------------------------------------------
# Drill 4: Gateway API & Advanced Routing (Cilium Gateway API)
# ------------------------------------------------------------------------------
echo "--------------------------------------------------------------------"
echo "  [4/5] Testing Gateway API, HTTPRoute & TLSRoute                   "
echo "--------------------------------------------------------------------"
"${SCRIPT_DIR}/03-gateway-api/test-gateway.sh"

# ------------------------------------------------------------------------------
# Drill 5: Kubernetes Network Policies
# ------------------------------------------------------------------------------
echo "--------------------------------------------------------------------"
echo "  [5/5] Testing Kubernetes NetworkPolicies                          "
echo "--------------------------------------------------------------------"
echo "==> Running Multi-Namespace Isolation Drill..."
"${SCRIPT_DIR}/04-network-policies/test-network-policies.sh"

echo "==> Running Fine-Grained my-app Ingress/Egress Drill..."
"${SCRIPT_DIR}/04-network-policies/test-my-app-network-policy.sh"

echo "===================================================================="
echo "  [SUCCESS] All CKA Networking drills verified successfully!        "
echo "===================================================================="

