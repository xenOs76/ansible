#!/usr/bin/env bash
# ==============================================================================
# test-configmaps-drills.sh: Automated Validation Suite for ConfigMaps & Secrets
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_NS="{{ cka_lab_configmaps_default_namespace | default('default') }}"
DEV_NS="{{ cka_lab_configmaps_dev_namespace | default('development') }}"

echo "===================================================================="
echo "  [CKA LAB] Running End-to-End ConfigMaps & Secrets Drill Suite     "
echo "===================================================================="

# Helper cleanup function
cleanup() {
  echo "==> Cleaning up test pods and temporary drill resources..."
  kubectl delete pod cka-single-env-pod cka-bulk-envfrom-pod cka-volume-dir-pod \
    cka-subpath-pod -n "${DEFAULT_NS}" --ignore-not-found=true --now >/dev/null 2>&1 || true
  kubectl delete configmap cka-cm-literals cka-cm-files cka-cm-env-file \
    cka-immutable-config -n "${DEFAULT_NS}" --ignore-not-found=true >/dev/null 2>&1 || true
  kubectl delete secret cka-sec-literals -n "${DEFAULT_NS}" --ignore-not-found=true >/dev/null 2>&1 || true
}

trap cleanup EXIT

# ------------------------------------------------------------------------------
# Test 1: Verify Baseline Pre-rendered ConfigMaps
# ------------------------------------------------------------------------------
echo "==> [1/5] Verifying baseline pre-rendered ConfigMaps across namespaces..."
for cm in sample-app-config sample-service-config sample-system-config; do
  kubectl get configmap "${cm}" -n "${DEFAULT_NS}" -o name >/dev/null
  echo "  ✓ default/${cm} verified"
done

for cm in dev-app-config dev-service-config dev-system-config; do
  kubectl get configmap "${cm}" -n "${DEV_NS}" -o name >/dev/null
  echo "  ✓ ${DEV_NS}/${cm} verified"
done

# ------------------------------------------------------------------------------
# Test 2: Rapid Imperative Creation Drills
# ------------------------------------------------------------------------------
echo "==> [2/5] Executing Drill 1: Rapid Imperative Creation..."
bash "${SCRIPT_DIR}/01-imperative-creation/run-imperative.sh"

kubectl get configmap cka-cm-literals -n "${DEFAULT_NS}" >/dev/null
kubectl get configmap cka-cm-files -n "${DEFAULT_NS}" >/dev/null
kubectl get configmap cka-cm-env-file -n "${DEFAULT_NS}" >/dev/null
kubectl get secret cka-sec-literals -n "${DEFAULT_NS}" >/dev/null
echo "  ✓ Imperative ConfigMaps and Secret verified in ${DEFAULT_NS}."

# ------------------------------------------------------------------------------
# Test 3: Environment Variable Injection (Granular vs. Bulk envFrom)
# ------------------------------------------------------------------------------
echo "==> [3/5] Executing Drill 2: Environment Variable Injection..."
echo "  Applying cka-single-env-pod..."
kubectl apply -f "${SCRIPT_DIR}/02-env-var-injection/01-single-env-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-single-env-pod -n "${DEFAULT_NS}" --timeout=60s

SINGLE_ENV=$(kubectl exec cka-single-env-pod -n "${DEFAULT_NS}" -- env | grep "CONTAINER_ENV=production")
echo "  ✓ Granular injection verified: ${SINGLE_ENV}"

echo "  Applying cka-bulk-envfrom-pod..."
kubectl apply -f "${SCRIPT_DIR}/02-env-var-injection/02-bulk-envfrom-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-bulk-envfrom-pod -n "${DEFAULT_NS}" --timeout=60s

BULK_ENV_CFG=$(kubectl exec cka-bulk-envfrom-pod -n "${DEFAULT_NS}" -- env | grep "CFG_APP_ENV=production")
BULK_ENV_SEC=$(kubectl exec cka-bulk-envfrom-pod -n "${DEFAULT_NS}" -- env | grep "SEC_username=appadmin")
echo "  ✓ Bulk envFrom injection verified: ${BULK_ENV_CFG}, ${BULK_ENV_SEC}"

# ------------------------------------------------------------------------------
# Test 4: Volume Mounts & subPath Projections
# ------------------------------------------------------------------------------
echo "==> [4/5] Executing Drill 3: Volume Mounts & subPath Projections..."
echo "  Applying cka-volume-dir-pod..."
kubectl apply -f "${SCRIPT_DIR}/03-volume-mounts-subpath/01-volume-directory-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-volume-dir-pod -n "${DEFAULT_NS}" --timeout=60s

DIR_CONTENT=$(kubectl exec cka-volume-dir-pod -n "${DEFAULT_NS}" -- cat /etc/sample-config/application.properties | grep "server.port=8080")
echo "  ✓ Directory mount verified: ${DIR_CONTENT}"

echo "  Applying cka-subpath-pod..."
kubectl apply -f "${SCRIPT_DIR}/03-volume-mounts-subpath/02-subpath-single-file-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-subpath-pod -n "${DEFAULT_NS}" --timeout=60s

SUBPATH_CONF=$(kubectl exec cka-subpath-pod -n "${DEFAULT_NS}" -- cat /etc/nginx/conf.d/default.conf | grep "sample.default.svc.cluster.local")
echo "  ✓ subPath single-file injection verified: ${SUBPATH_CONF}"

# ------------------------------------------------------------------------------
# Test 5: Specification Immutability Drill
# ------------------------------------------------------------------------------
echo "==> [5/5] Executing Drill 4: Spec Immutability & Rejection..."
bash "${SCRIPT_DIR}/04-immutability-drill/test-immutability.sh"
echo "  ✓ Specification immutability drill verified."

echo "===================================================================="
echo "  [CKA LAB] All ConfigMaps & Secrets Drills Passed Successfully!    "
echo "===================================================================="
