apiVersion: v1
kind: Pod
metadata:
  name: hostpath-log-viewer
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-hostpath
spec:
  containers:
    - name: log-viewer
      image: busybox:1.36
      command: ["sh", "-c", "ls -lah /host/var/log && sleep 3600"]
      volumeMounts:
        - name: host-var-log
          mountPath: /host/var/log
          readOnly: true
  volumes:
    - name: host-var-log
      hostPath:
        path: /var/log
        type: Directory
