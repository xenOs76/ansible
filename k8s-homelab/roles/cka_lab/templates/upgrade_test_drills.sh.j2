#!/usr/bin/env bash
# ==============================================================================
# test-upgrade-drills.sh: Master automated test harness for Kubeadm Upgrade
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPRECATIONS_SCRIPT="${SCRIPT_DIR}/00-pre-upgrade-deprecations/test-deprecations-drill.sh"
CP_SCRIPT="${SCRIPT_DIR}/01-control-plane/mock-control-plane-upgrade.sh"
SECONDARY_CP_SCRIPT="${SCRIPT_DIR}/02-secondary-control-plane/mock-secondary-cp-upgrade.sh"
WORKER_SCRIPT="${SCRIPT_DIR}/03-worker-node/mock-worker-upgrade.sh"

echo "=========================================================="
echo " Running Automated Validation: CKA Kubeadm Upgrade Drills"
echo "=========================================================="

FAILED=0

run_test() {
    local name="$1"
    local cmd="$2"
    echo -n "Test: ${name} ... "
    if eval "${cmd}" >/dev/null 2>&1; then
        echo "PASS"
    else
        echo "FAIL"
        FAILED=$(( FAILED + 1 ))
    fi
}

# 1. Execute Phase 0 pre-upgrade deprecations test suite
run_test "Phase 0: Pre-upgrade API deprecations drill" "bash ${DEPRECATIONS_SCRIPT}"

# 2. Verify kubeadm binary exists
run_test "kubeadm binary available" "command -v kubeadm"

# 3. Verify kubelet binary exists
run_test "kubelet binary available" "command -v kubelet"

# 4. Verify kubectl binary exists
run_test "kubectl binary available" "command -v kubectl"

# 5. Check package holds on current node
run_test "dpkg package hold verification" "dpkg --get-selections | grep -q 'hold'"

# 6. Run control plane mock upgrade script
run_test "Phase 1: Control plane mock script execution" "bash ${CP_SCRIPT}"

# 7. Run secondary control plane mock upgrade script
run_test "Phase 2: Secondary control plane mock script execution" "bash ${SECONDARY_CP_SCRIPT}"

# 8. Run worker node mock upgrade script
run_test "Phase 3: Worker mock script execution" "bash ${WORKER_SCRIPT}"

echo "=========================================================="
if [[ ${FAILED} -eq 0 ]]; then
    echo " All Kubeadm Upgrade drill tests PASSED!"
    exit 0
else
    echo " ${FAILED} test(s) FAILED in upgrade drill."
    exit 1
fi
