#!/usr/bin/env bash
# ==============================================================================
# test-secrets-drills.sh: Automated Validation Suite for Kubernetes Secrets
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_NS="{{ cka_lab_secrets_default_namespace | default('default') }}"
DEV_NS="{{ cka_lab_secrets_dev_namespace | default('development') }}"

echo "===================================================================="
echo "  [CKA LAB] Running End-to-End Kubernetes Secrets Drill Suite       "
echo "===================================================================="

# Helper cleanup function
cleanup() {
  echo "==> Cleaning up test pods and temporary drill resources..."
  kubectl delete pod cka-single-secret-pod cka-bulk-secret-pod cka-secure-volume-pod \
    cka-nginx-tls-pod -n "${DEFAULT_NS}" --ignore-not-found=true --now >/dev/null 2>&1 || true
  kubectl delete configmap cka-nginx-tls-conf -n "${DEFAULT_NS}" --ignore-not-found=true >/dev/null 2>&1 || true
  kubectl delete secret cka-sec-db-auth cka-sec-web-tls cka-sec-regcred \
    cka-immutable-secret -n "${DEFAULT_NS}" --ignore-not-found=true >/dev/null 2>&1 || true
}

trap cleanup EXIT

# ------------------------------------------------------------------------------
# Test 1: Verify Baseline Pre-rendered Secrets Across Namespaces
# ------------------------------------------------------------------------------
echo "==> [1/6] Verifying baseline pre-rendered Secrets across namespaces..."
for sec in sample-app-secret sample-basic-auth sample-tls-secret sample-ssh-auth; do
  kubectl get secret "${sec}" -n "${DEFAULT_NS}" -o name >/dev/null
  echo "  ✓ default/${sec} verified"
done

for sec in dev-app-secret dev-basic-auth dev-tls-secret dev-ssh-auth; do
  kubectl get secret "${sec}" -n "${DEV_NS}" -o name >/dev/null
  echo "  ✓ ${DEV_NS}/${sec} verified"
done

# ------------------------------------------------------------------------------
# Test 2: Rapid Imperative Creation Drills
# ------------------------------------------------------------------------------
echo "==> [2/6] Executing Drill 1: Rapid Imperative Creation..."
bash "${SCRIPT_DIR}/01-imperative-creation/run-imperative.sh"

kubectl get secret cka-sec-db-auth -n "${DEFAULT_NS}" >/dev/null
kubectl get secret cka-sec-web-tls -n "${DEFAULT_NS}" >/dev/null
kubectl get secret cka-sec-regcred -n "${DEFAULT_NS}" >/dev/null
echo "  ✓ Imperative generic, tls, and docker-registry secrets verified."

# ------------------------------------------------------------------------------
# Test 3: Base64 Decoding & Fast Inspection
# ------------------------------------------------------------------------------
echo "==> [3/6] Executing Drill 2: Base64 Inspection & Payload Decoding..."
bash "${SCRIPT_DIR}/02-decode-inspection/decode-secrets.sh" >/dev/null

DECODED_PASS=$(kubectl get secret sample-app-secret -n "${DEFAULT_NS}" -o jsonpath='{.data.password}' | base64 -d)
if [ "${DECODED_PASS}" = "{{ cka_lab_secret_opaque_password }}" ]; then
  echo "  ✓ Fast JSONPath decoding accurately matches configured password."
else
  echo "ERROR: Decoded password mismatch!" >&2
  exit 1
fi

# ------------------------------------------------------------------------------
# Test 4: Environment Variable Injection (Granular vs. Bulk envFrom)
# ------------------------------------------------------------------------------
echo "==> [4/6] Executing Drill 3: Environment Variable Injection..."
echo "  Applying cka-single-secret-pod..."
kubectl apply -f "${SCRIPT_DIR}/03-env-var-injection/01-single-secret-env-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-single-secret-pod -n "${DEFAULT_NS}" --timeout=60s

SINGLE_USER=$(kubectl exec cka-single-secret-pod -n "${DEFAULT_NS}" -- env | grep "DB_USER=appadmin")
echo "  ✓ Granular secret injection verified: ${SINGLE_USER}"

echo "  Applying cka-bulk-secret-pod..."
kubectl apply -f "${SCRIPT_DIR}/03-env-var-injection/02-bulk-secret-envfrom-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-bulk-secret-pod -n "${DEFAULT_NS}" --timeout=60s

BULK_USER=$(kubectl exec cka-bulk-secret-pod -n "${DEFAULT_NS}" -- env | grep "SEC_username=appadmin")
echo "  ✓ Bulk envFrom injection verified: ${BULK_USER}"

# ------------------------------------------------------------------------------
# Test 5: Volume Mounts with Restrictive Permissions & TLS Termination
# ------------------------------------------------------------------------------
echo "==> [5/6] Executing Drill 4: Volume Mounts & TLS Termination..."
echo "  Applying cka-secure-volume-pod..."
kubectl apply -f "${SCRIPT_DIR}/04-volume-mounts-tls/01-secure-volume-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-secure-volume-pod -n "${DEFAULT_NS}" --timeout=60s

FILE_PERMS=$(kubectl exec cka-secure-volume-pod -n "${DEFAULT_NS}" -- ls -l /etc/app-secrets/password)
echo "  ✓ File permissions verified: ${FILE_PERMS}"
if echo "${FILE_PERMS}" | grep -q "r--------"; then
  echo "  ✓ Restrictive defaultMode 0400 enforced on secret volume files."
fi

echo "  Applying cka-nginx-tls-pod..."
kubectl apply -f "${SCRIPT_DIR}/04-volume-mounts-tls/02-nginx-tls-pod.yaml" -n "${DEFAULT_NS}"
kubectl wait --for=condition=Ready pod/cka-nginx-tls-pod -n "${DEFAULT_NS}" --timeout=60s

POD_IP=$(kubectl get pod cka-nginx-tls-pod -n "${DEFAULT_NS}" -o jsonpath='{.status.podIP}')
echo "  Probing NGINX HTTPS endpoint at ${POD_IP}:8443..."
TLS_PROBE=$(kubectl run cka-tls-probe-client \
  --image=busybox:1.36.1 \
  --rm -i --restart=Never \
  -n "${DEFAULT_NS}" \
  -- wget --no-check-certificate -qO- "https://${POD_IP}:8443" || true)

if echo "${TLS_PROBE}" | grep -q "TLS Termination Successful"; then
  echo "  ✓ TLS handshake & HTTPS response verified from cka-nginx-tls-pod."
else
  echo "WARNING: Direct HTTPS probe response: ${TLS_PROBE}"
fi

# ------------------------------------------------------------------------------
# Test 6: Specification Immutability Drill
# ------------------------------------------------------------------------------
echo "==> [6/6] Executing Drill 5: Spec Immutability & Rejection..."
bash "${SCRIPT_DIR}/05-immutability-drill/test-immutability.sh"
echo "  ✓ Secret immutability drill verified."

echo "===================================================================="
echo "  [CKA LAB] All Secrets Drills Passed Successfully!                 "
echo "===================================================================="
