---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: fc-multipath-pv
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
    storage-tier: fc-san
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  volumeMode: Filesystem
  storageClassName: "{{ cka_lab_fc_storage_class | default('fc-manual') }}"
  fc:
    targetWWNs:
{% for wwn in cka_lab_fc_target_wwns %}
      - "{{ wwn }}"
{% endfor %}
    lun: {{ cka_lab_fc_fs_lun | default(0) }}
    fsType: ext4
    readOnly: false
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: fc-multipath-claim
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Filesystem
  storageClassName: "{{ cka_lab_fc_storage_class | default('fc-manual') }}"
  resources:
    requests:
      storage: 500Mi
  volumeName: fc-multipath-pv
---
apiVersion: v1
kind: Pod
metadata:
  name: fc-multipath-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
spec:
  containers:
    - name: multipath-app
      image: alpine:latest
      command: ["/bin/sh", "-c"]
      args:
        - |
          echo "Dual-fabric Fibre Channel SAN volume mounted at $(date)" > /mnt/storage/multipath-test.txt
          sync
          while true; do sleep 3600; done
      volumeMounts:
        - name: fc-multipath-vol
          mountPath: /mnt/storage
  volumes:
    - name: fc-multipath-vol
      persistentVolumeClaim:
        claimName: fc-multipath-claim
