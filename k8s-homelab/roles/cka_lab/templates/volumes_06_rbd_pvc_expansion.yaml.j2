# ==============================================================================
# CKA Lab Drill: Online PersistentVolumeClaim Expansion with Ceph RBD
# ==============================================================================
# Step 1: Apply initial 1Gi claim and consumer pod (see 01-rbd-dynamic-filesystem.yaml).
# Step 2: Edit or patch the PVC to request 2Gi:
#
#   kubectl patch pvc rbd-claim-fs -p '{"spec":{"resources":{"requests":{"storage":"2Gi"}}}}'
#
# Step 3: Observe PVC conditions:
#
#   kubectl describe pvc rbd-claim-fs
#
# Ceph CSI resizes the underlying RBD image, and the kubelet resizes the ext4 filesystem
# on the node while the pod is still running without restart.
#
# Step 4: Verify expanded size inside the running container:
#
#   kubectl exec rbd-fs-consumer-pod -- df -h /mnt/storage
# ==============================================================================
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: rbd-claim-fs-expanded
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: rbd-volumes
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Filesystem
  storageClassName: {{ cka_lab_rbd_storage_class }}
  resources:
    requests:
      storage: 2Gi
