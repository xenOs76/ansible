---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cka-lab-allow-dns-egress
  namespace: {{ cka_lab_networking_client_namespace | default('cka-lab-net-client') }}
  labels:
    app.kubernetes.io/name: cka-lab-allow-dns-egress
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector: {}
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ cka_lab_networking_backend_namespace | default('cka-lab-net-backend') }}
      ports:
        - protocol: TCP
          port: 80
