#!/usr/bin/env bash
# ==============================================================================
# run-imperative.sh: Rapid imperative creation drills for Kubernetes Secrets
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_NS="{{ cka_lab_secrets_default_namespace | default('default') }}"
SECRETS_DIR="{{ cka_lab_secrets_dir }}"

echo "===================================================================="
echo "  [CKA LAB] Drill 1: Rapid Imperative Creation (Secrets)            "
echo "===================================================================="
echo "Target namespace: ${TARGET_NS}"

# 1. Create Generic Secret from literals and file
echo "==> 1. Creating generic secret from literals and file..."
kubectl create secret generic cka-sec-db-auth \
  --from-literal=username=dbadmin \
  --from-literal=password='VerySecurePassword2026!' \
  --from-file=credentials="${SCRIPT_DIR}/db-creds.txt" \
  -n "${TARGET_NS}" \
  --dry-run=client -o yaml | kubectl apply -f -

# 2. Create TLS Secret from certificate and private key
echo "==> 2. Creating TLS secret from cert and private key..."
kubectl create secret tls cka-sec-web-tls \
  --cert="${SECRETS_DIR}/sample-tls.crt" \
  --key="${SECRETS_DIR}/sample-tls.key" \
  -n "${TARGET_NS}" \
  --dry-run=client -o yaml | kubectl apply -f -

# 3. Create Docker Registry Secret (dockerconfigjson)
echo "==> 3. Creating docker-registry secret..."
kubectl create secret docker-registry cka-sec-regcred \
  --docker-server=registry.internal.lan:5000 \
  --docker-username=builduser \
  --docker-password='DockerToken#987' \
  --docker-email=build@cluster.local \
  -n "${TARGET_NS}" \
  --dry-run=client -o yaml | kubectl apply -f -

echo "==> Verification:"
echo "--- cka-sec-db-auth type and keys ---"
kubectl get secret cka-sec-db-auth -n "${TARGET_NS}" -o jsonpath='Type: {.type}, Keys: {keys .data}'
echo ""
echo "--- cka-sec-web-tls type and keys ---"
kubectl get secret cka-sec-web-tls -n "${TARGET_NS}" -o jsonpath='Type: {.type}, Keys: {keys .data}'
echo ""
echo "--- cka-sec-regcred type and keys ---"
kubectl get secret cka-sec-regcred -n "${TARGET_NS}" -o jsonpath='Type: {.type}, Keys: {keys .data}'
echo ""

echo "==> Imperative secret creation drills completed successfully."
