apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-storage-consumer
  namespace: {{ cka_lab_storage_classes_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-storage-consumer
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: storage-classes
spec:
  containers:
    - name: writer
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - "echo 'DYNAMIC_STORAGE_VALIDATED=true' > /data/status.txt && sleep 3600"
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
      volumeMounts:
        - name: app-storage
          mountPath: /data
  volumes:
    - name: app-storage
      persistentVolumeClaim:
        claimName: cka-lab-dynamic-pvc
