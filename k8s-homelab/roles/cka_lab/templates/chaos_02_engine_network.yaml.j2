---
apiVersion: litmuschaos.io/v1alpha1
kind: ChaosEngine
metadata:
  name: cka-lab-network-chaos
  namespace: {{ cka_lab_chaos_namespace }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/drill: network-latency-loss
spec:
  engineState: "active"
  appinfo:
    appns: "{{ cka_lab_chaos_namespace }}"
    applabel: "app=cka-lab-payment-svc"
    appkind: "deployment"
  chaosServiceAccount: litmus-admin
  experiments:
    - name: pod-network-loss
      spec:
        components:
          env:
            - name: TOTAL_CHAOS_DURATION
              value: "300"
            - name: NETWORK_PACKET_LOSS_PERCENTAGE
              value: "70"
            - name: CONTAINER_RUNTIME
              value: "containerd"
            - name: SOCKET_PATH
              value: "/run/containerd/containerd.sock"
