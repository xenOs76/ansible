apiVersion: apps/v1
kind: Deployment
metadata:
  name: cka-lab-api-service
  namespace: {{ cka_lab_deployments_namespace | default('default') }}
  labels:
    app: cka-lab-api-service
spec:
  replicas: 2
  selector:
    matchLabels:
      app: cka-lab-api-service
  template:
    metadata:
      labels:
        app: cka-lab-api-service
    spec:
      containers:
        - name: api
          image: busybox:1.36
          command:
            - sh
            - -c
            - "while true; do echo 'api-service running'; sleep 15; done"
