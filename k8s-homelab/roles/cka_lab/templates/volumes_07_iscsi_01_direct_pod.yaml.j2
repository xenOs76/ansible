---
apiVersion: v1
kind: Pod
metadata:
  name: iscsi-direct-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: iscsi-volumes
spec:
  containers:
    - name: storage-app
      image: alpine:latest
      command: ["/bin/sh", "-c"]
      args:
        - |
          echo "Writing test payload to direct iSCSI mount..."
          echo "iSCSI direct volume mounted at $(date)" > /mnt/storage/direct-test.txt
          sync
          tail -f /dev/null
      volumeMounts:
        - name: iscsi-volume
          mountPath: /mnt/storage
  volumes:
    - name: iscsi-volume
      iscsi:
        targetPortal: "{{ cka_lab_iscsi_portal }}"
        iqn: "{{ cka_lab_iscsi_iqn }}"
        lun: {{ cka_lab_iscsi_fs_lun | default(1) }}
        fsType: ext4
        readOnly: false
