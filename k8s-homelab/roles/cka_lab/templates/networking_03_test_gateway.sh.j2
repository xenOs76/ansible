#!/usr/bin/env bash
# ==============================================================================
# test-gateway.sh: Non-Interactive Verification of Gateway API, HTTPRoute & TLSRoute
# ==============================================================================
set -euo pipefail

NAMESPACE="{{ cka_lab_networking_namespace | default('default') }}"
DOMAIN="{{ cka_lab_networking_gateway_domain | default('httpbin.example.local') }}"
UNMATCHED_DOMAIN="{{ cka_lab_networking_gateway_unmatched_domain | default('unmatched.example.local') }}"
TLS_DOMAIN="{{ cka_lab_networking_gateway_tls_domain | default('secure.example.local') }}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HTTP_PORT="{{ cka_lab_networking_gateway_http_port | default(30080) }}"
GW_NAMESPACE="{{ cka_lab_helm_ngf_namespace | default('nginx-gateway') }}"

echo "==> [Gateway API Drill] Verifying Gateway API prerequisites..."
if ! kubectl get crd gateways.gateway.networking.k8s.io >/dev/null 2>&1; then
  echo "Installing Gateway API experimental CRDs (v1.2.1)..."
  kubectl apply --server-side --force-conflicts -f \
    "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/experimental-install.yaml"
fi

if ! kubectl get gatewayclass cilium-nodeport >/dev/null 2>&1 && \
   ! kubectl get gatewayclass cilium >/dev/null 2>&1 && \
   ! kubectl get gatewayclass nginx >/dev/null 2>&1; then
  echo "    Notice: No recognized GatewayClass (cilium-nodeport, cilium, or nginx) is registered."
  echo "    Please enable Cilium Gateway API first:"
  echo "      /home/vagrant/cni-enable-ingress-gateway.sh"
  echo "    (Or deploy NGINX Gateway Fabric: /home/vagrant/cka/helm/install-nginx-gateway-fabric.sh)."
fi

# Ensure target gateway namespace exists
kubectl create namespace "${GW_NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f - >/dev/null 2>&1 || true

# Ensure self-signed TLS secret exists for Gateway HTTPS terminate listener
if ! kubectl get secret cka-lab-gateway-tls -n "${GW_NAMESPACE}" >/dev/null 2>&1; then
  echo "==> Generating self-signed TLS certificate secret for Gateway in ${GW_NAMESPACE}..."
  TMP_CERT=$(mktemp)
  TMP_KEY=$(mktemp)
  openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout "${TMP_KEY}" -out "${TMP_CERT}" \
    -subj "/CN=${DOMAIN}" >/dev/null 2>&1
  kubectl create secret tls cka-lab-gateway-tls \
    --cert="${TMP_CERT}" --key="${TMP_KEY}" -n "${GW_NAMESPACE}"
  rm -f "${TMP_CERT}" "${TMP_KEY}"
fi

echo "==> Applying Gateway, HTTPRoute (basic & advanced), and TLSRoute manifests..."
kubectl apply -f "${SCRIPT_DIR}/cka-lab-gateway.yaml"
kubectl apply -f "${SCRIPT_DIR}/cka-lab-httproute.yaml" -n "${NAMESPACE}"
kubectl apply -f "${SCRIPT_DIR}/cka-lab-httproute-advanced.yaml" -n "${NAMESPACE}"
kubectl apply -f "${SCRIPT_DIR}/cka-lab-tlsroute.yaml" -n "${NAMESPACE}"

echo "Waiting up to 30s for Gateway to be accepted..."
for _ in {1..30}; do
  if kubectl get gateway cka-lab-gateway -n "${GW_NAMESPACE}" >/dev/null 2>&1; then
    echo "Gateway cka-lab-gateway exists in ${GW_NAMESPACE}."
    break
  fi
  sleep 1
done

echo "==> Active Gateway API Resources:"
kubectl get gateway -n "${GW_NAMESPACE}"
kubectl get httproute -n "${NAMESPACE}"
kubectl get tlsroute -n "${NAMESPACE}"

NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')

# Detect and optionally enforce deterministic NodePort on the generated Gateway service
for _ in {1..15}; do
  if kubectl get svc -n "${GW_NAMESPACE}" -l gateway.networking.k8s.io/gateway-name=cka-lab-gateway >/dev/null 2>&1 || \
     kubectl get svc -n "${GW_NAMESPACE}" cilium-gateway-cka-lab-gateway >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

GW_SVC=$(kubectl get svc -n "${GW_NAMESPACE}" -l gateway.networking.k8s.io/gateway-name=cka-lab-gateway -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "cilium-gateway-cka-lab-gateway")
if kubectl get svc "${GW_SVC}" -n "${GW_NAMESPACE}" >/dev/null 2>&1; then
  CURRENT_NODEPORT=$(kubectl get svc "${GW_SVC}" -n "${GW_NAMESPACE}" -o jsonpath='{.spec.ports[?(@.port==80)].nodePort}' 2>/dev/null || echo "")
  if [ -n "${CURRENT_NODEPORT}" ] && [ "${CURRENT_NODEPORT}" != "${HTTP_PORT}" ]; then
    kubectl patch svc "${GW_SVC}" -n "${GW_NAMESPACE}" --type='merge' \
      -p "{\"spec\":{\"ports\":[{\"name\":\"http\",\"port\":80,\"nodePort\":${HTTP_PORT}}]}}" 2>/dev/null || true
  fi
  DETECTED_PORT=$(kubectl get svc "${GW_SVC}" -n "${GW_NAMESPACE}" -o jsonpath='{.spec.ports[?(@.port==80)].nodePort}' 2>/dev/null || echo "")
  if [ -n "${DETECTED_PORT:-}" ] && [ "${DETECTED_PORT}" != "null" ]; then
    HTTP_PORT="${DETECTED_PORT}"
  fi
fi

echo "==> Testing Gateway API reachability on ${NODE_IP}:${HTTP_PORT}..."

echo "==> [Test 1] Valid hostname routing (Host: ${DOMAIN})..."
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -m 5 -H "Host: ${DOMAIN}" "http://${NODE_IP}:${HTTP_PORT}/" || echo "000")
echo "HTTP response status for Host: ${DOMAIN} on / : ${HTTP_STATUS}"
if [ "${HTTP_STATUS}" != "200" ]; then
  echo "Warning: Expected HTTP 200 for matching host ${DOMAIN}, got ${HTTP_STATUS}" >&2
fi

echo "==> [Test 2] Negative hostname filtering (Host: ${UNMATCHED_DOMAIN} -> Expect 404)..."
UNMATCHED_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -m 5 -H "Host: ${UNMATCHED_DOMAIN}" "http://${NODE_IP}:${HTTP_PORT}/" || echo "000")
echo "HTTP response status for unmatched host: ${UNMATCHED_STATUS}"
if [ "${UNMATCHED_STATUS}" != "404" ]; then
  echo "Warning: Expected HTTP 404 for unmatched host ${UNMATCHED_DOMAIN}, got ${UNMATCHED_STATUS}" >&2
fi

if kubectl get svc httpbingo -n "${NAMESPACE}" >/dev/null 2>&1; then
  echo "==> [Test 3] Testing httpbin-go route on /get..."
  HTTPBIN_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -m 5 -H "Host: ${DOMAIN}" "http://${NODE_IP}:${HTTP_PORT}/get" || echo "000")
  echo "HTTP response status for /get: ${HTTPBIN_STATUS}"
fi

if kubectl get svc cka-lab-ingress-api-svc -n "${NAMESPACE}" >/dev/null 2>&1; then
  echo "==> [Test 4] Testing API backend route on /api..."
  API_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -m 5 -H "Host: ${DOMAIN}" "http://${NODE_IP}:${HTTP_PORT}/api" || echo "000")
  echo "HTTP response status for /api: ${API_STATUS}"
fi

echo "==> [Test 5] Advanced HTTPRoute: Complex Match (Path /api/v2 + Header version: 2 + QueryParam env=canary)..."
CANARY_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -m 5 \
  -H "Host: ${DOMAIN}" \
  -H "version: 2" \
  "http://${NODE_IP}:${HTTP_PORT}/api/v2?env=canary" || echo "000")
echo "HTTP response status for complex canary match: ${CANARY_STATUS}"

echo "==> [Test 6] Advanced HTTPRoute: Alternate OR Match (/canary/api unconditional)..."
OR_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -m 5 \
  -H "Host: ${DOMAIN}" \
  "http://${NODE_IP}:${HTTP_PORT}/canary/api" || echo "000")
echo "HTTP response status for alternate OR match: ${OR_STATUS}"

echo "==> [Test 7] Advanced HTTPRoute: RequestRedirect filter (/legacy-api -> /api)..."
REDIRECT_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -m 5 \
  -H "Host: ${DOMAIN}" \
  "http://${NODE_IP}:${HTTP_PORT}/legacy-api" || echo "000")
echo "HTTP response status for /legacy-api redirect: ${REDIRECT_STATUS}"

echo "==> [Test 8] TLSRoute Registration & SNI Configuration Check..."
if kubectl get tlsroute cka-lab-tlsroute -n "${NAMESPACE}" >/dev/null 2>&1; then
  echo "    OK: TLSRoute 'cka-lab-tlsroute' registered with hostname '${TLS_DOMAIN}'."
fi

echo "==> Gateway API drill verification complete."
