---
apiVersion: v1
kind: Pod
metadata:
  name: frontend-processor
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    app: frontend-processor
spec:
  containers:
    - name: processor
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - "while true; do sleep 3600; done"
      readinessProbe:
        exec:
          command:
            - /bin/sh
            - -c
            - "wget -T2 -q -O- http://order-service.default.svc.cluster.local:80/"
        initialDelaySeconds: 2
        periodSeconds: 3
        failureThreshold: 2
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
