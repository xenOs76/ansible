apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-web-service
  namespace: {{ cka_lab_pods_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-web-service
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: pods
    tier: frontend
spec:
  restartPolicy: Always
  containers:
    - name: web-server
      image: nginx:alpine
      ports:
        - containerPort: 80
          name: http
      env:
        - name: APP_ENV
          value: "production"
        - name: LOG_LEVEL
          value: "info"
        - name: SERVICE_PORT
          value: "80"
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 64Mi
