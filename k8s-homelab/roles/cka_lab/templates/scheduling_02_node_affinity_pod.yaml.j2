apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-node-affinity-pod
  namespace: {{ cka_lab_scheduling_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-node-affinity-pod
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: scheduling
spec:
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: "cka.zone"
                operator: In
                values:
                  - "zone-a"
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 50
          preference:
            matchExpressions:
              - key: "disktype"
                operator: In
                values:
                  - "nvme"
  containers:
    - name: worker
      image: busybox:1.36.1
      command: ["/bin/sh", "-c", "sleep 3600"]
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
