---
apiVersion: v1
kind: Pod
metadata:
  name: fc-direct-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
spec:
  containers:
    - name: app
      image: alpine:latest
      command: ["/bin/sh", "-c"]
      args:
        - |
          echo "Fibre Channel SAN direct volume mounted at $(date)" > /mnt/storage/direct-test.txt
          sync
          while true; do sleep 3600; done
      volumeMounts:
        - name: fc-direct-vol
          mountPath: /mnt/storage
  volumes:
    - name: fc-direct-vol
      fc:
        targetWWNs:
          - "{{ cka_lab_fc_target_wwns[0] }}"
        lun: {{ cka_lab_fc_fs_lun | default(0) }}
        fsType: ext4
        readOnly: false
