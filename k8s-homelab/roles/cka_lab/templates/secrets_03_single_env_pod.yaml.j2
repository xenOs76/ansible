apiVersion: v1
kind: Pod
metadata:
  name: cka-single-secret-pod
  namespace: {{ cka_lab_secrets_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets-env
spec:
  restartPolicy: Never
  containers:
    - name: consumer
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - |
          echo "DB_USER: ${DB_USER}"
          echo "DB_PASSWORD: ${DB_PASSWORD}"
          echo "DB_CONNECTION: ${DB_CONNECTION}"
          sleep 3600
      env:
        - name: DB_USER
          valueFrom:
            secretKeyRef:
              name: sample-app-secret
              key: username
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: sample-app-secret
              key: password
        - name: DB_CONNECTION
          valueFrom:
            secretKeyRef:
              name: sample-app-secret
              key: database-url
