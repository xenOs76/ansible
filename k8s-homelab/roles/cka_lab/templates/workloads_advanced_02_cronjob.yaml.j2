apiVersion: batch/v1
kind: CronJob
metadata:
  name: cka-lab-cronjob
  namespace: {{ cka_lab_workloads_advanced_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-cronjob
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: workloads-advanced
spec:
  schedule: "*/1 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app: cka-lab-cron-worker
            cka.practice/scenario: workloads-advanced
        spec:
          restartPolicy: OnFailure
          containers:
            - name: cron-task
              image: busybox:1.36.1
              command:
                - /bin/sh
                - -c
                - "date && echo 'Scheduled maintenance completed.'"
              resources:
                requests:
                  cpu: 10m
                  memory: 16Mi
                limits:
                  cpu: 50m
                  memory: 32Mi
