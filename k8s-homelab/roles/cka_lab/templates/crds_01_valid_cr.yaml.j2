apiVersion: automation.cka.priv/v1
kind: BackupSchedule
metadata:
  name: cka-lab-daily-backup
  namespace: {{ cka_lab_crds_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-daily-backup
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: crds
spec:
  targetNamespace: "development"
  retentionDays: 30
  cronExpression: "0 2 * * *"
