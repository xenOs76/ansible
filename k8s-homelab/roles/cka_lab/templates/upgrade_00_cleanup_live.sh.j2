#!/usr/bin/env bash
# ==============================================================================
# cleanup-live-deprecations.sh: Tear down live deprecation practice resources
# ==============================================================================
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

echo "=== CKA Phase 0: Cleaning Up Live Deprecation Practice Resources ==="
echo ""

if ! kubectl cluster-info >/dev/null 2>&1; then
    echo "[-] Error: Unable to connect to Kubernetes cluster." >&2
    exit 1
fi

echo "--- [1/3] Deleting Live Deprecated Workloads & Services ---"
kubectl delete pod legacy-sa-demo-pod -n default --ignore-not-found --grace-period=0 --force >/dev/null 2>&1 || true
kubectl delete service legacy-externalip-service -n default --ignore-not-found >/dev/null 2>&1 || true
kubectl delete appservice legacy-frontend-service -n default --ignore-not-found >/dev/null 2>&1 || true

echo "--- [2/3] Deleting Practice CRD ---"
kubectl delete crd appservices.drill.cka.io --ignore-not-found >/dev/null 2>&1 || true

echo "--- [3/3] Removing In-Cluster Synthetic Helm Release Secret ---"
"${SCRIPT_DIR}/simulate-helm-deprecation.sh" cleanup >/dev/null 2>&1 || true

echo ""
echo "[OK] All live deprecation drill resources removed cleanly."
