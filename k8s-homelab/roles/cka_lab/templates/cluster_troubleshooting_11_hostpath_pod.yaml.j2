---
apiVersion: v1
kind: Pod
metadata:
  name: cka-hostpath-app
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    tier: storage-drill
spec:
  # Container runs as non-root UID 1000 without fsGroup
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
  containers:
    - name: logger
      image: busybox:1.36
      command:
        - sh
        - -c
        - "echo 'Init log write' >> /data/app.log && tail -f /data/app.log"
      volumeMounts:
        - name: app-volume
          mountPath: /data
  volumes:
    - name: app-volume
      hostPath:
        path: /tmp/cka-hostpath-app-data
        type: DirectoryOrCreate
