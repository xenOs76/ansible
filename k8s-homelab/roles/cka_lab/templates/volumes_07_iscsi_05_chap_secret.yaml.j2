---
# ==============================================================================
# CKA Storage Drill: iSCSI with CHAP Authentication Secret
# ==============================================================================
# In secured enterprise storage arrays, iSCSI portals enforce CHAP credentials.
# Kubernetes mounts retrieve CHAP secrets via secretRef / discoverySecret.
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: iscsi-chap-secret
  namespace: default
type: "kubernetes.io/iscsi-chap"
data:
  # Base64 encoded: ckauser
  node.session.auth.username: "Y2thdXNlcg=="
  # Base64 encoded: CKAPassword2026!
  node.session.auth.password: "Q0tBUGFzc3dvcmQyMDI2IQ=="  # gitleaks:allow
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: iscsi-chap-pv
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: iscsi-volumes
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  volumeMode: Filesystem
  iscsi:
    targetPortal: "{{ cka_lab_iscsi_portal }}"
    iqn: "{{ cka_lab_iscsi_iqn }}"
    lun: {{ cka_lab_iscsi_fs_lun | default(1) }}
    fsType: ext4
    readOnly: false
    secretRef:
      name: iscsi-chap-secret
