#!/usr/bin/env bash
# ====================================================================
# [CKA LAB] Static Pod Diagnostics Drill: Fix Kube-Apiserver
# Restores the original static pod manifest and verifies API health.
# ====================================================================
set -euo pipefail

MANIFEST="/etc/kubernetes/manifests/kube-apiserver.yaml"
BACKUP="/etc/kubernetes/manifests/kube-apiserver.yaml.bak"

if [ "$(id -u)" -ne 0 ]; then
  echo "Error: This script modifies static pod manifests and must be run as root (use sudo)." >&2
  exit 1
fi

if [ -f "${BACKUP}" ]; then
  echo "==> Restoring ${MANIFEST} from ${BACKUP}..."
  cp -f "${BACKUP}" "${MANIFEST}"
  rm -f "${BACKUP}"
else
  echo "==> Backup not found, fixing known invalid parameter in-place..."
  sed -i 's|--etcd-cafile=/etc/kubernetes/pki/etcd/ca-broken.crt|--etcd-cafile=/etc/kubernetes/pki/etcd/ca.crt|g' "${MANIFEST}"
fi

echo "==> Awaiting kube-apiserver restart and recovery..."
for i in $(seq 1 30); do
  if kubectl get nodes --request-timeout=2s >/dev/null 2>&1; then
    echo "==> [SUCCESS] Kube-Apiserver is healthy and responding to queries!"
    kubectl get nodes
    exit 0
  fi
  echo "    Attempt ${i}/30: Waiting for API server to become ready..."
  sleep 3
done

echo "==> [WARNING] Kube-Apiserver did not recover within 90s. Inspect logs with: sudo crictl ps -a" >&2
exit 1
