#!/usr/bin/env bash
# ==============================================================================
# CKA Volumes Practice Lab - Fibre Channel (FC) SAN Verification Script
# Managed by Ansible (roles/cka_lab)
# ==============================================================================
set -euo pipefail

NAMESPACE="default"
WWPN_A="{{ cka_lab_fc_target_wwns[0] }}"
FS_LUN="{{ cka_lab_fc_fs_lun | default(0) }}"

POD_DIRECT="fc-direct-pod"
POD_PVC="fc-pvc-consumer-pod"
PVC_NAME="fc-claim"
PV_NAME="fc-static-pv"
POD_BLOCK="fc-raw-block-consumer-pod"
PVC_BLOCK="fc-raw-block-pvc"
PV_BLOCK="fc-raw-block-pv"
POD_MPATH="fc-multipath-pod"
PVC_MPATH="fc-multipath-claim"
PV_MPATH="fc-multipath-pv"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Detect KUBECONFIG if not set
if [ -z "${KUBECONFIG:-}" ] && [ -f /etc/kubernetes/admin.conf ] && [ ! -f "${HOME}/.kube/config" ]; then
  export KUBECONFIG=/etc/kubernetes/admin.conf
fi

cleanup() {
  echo "==> Cleaning up Fibre Channel SAN test resources..."
  kubectl delete pod "${POD_DIRECT}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pod "${POD_PVC}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pvc "${PVC_NAME}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pv "${PV_NAME}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pod "${POD_BLOCK}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pvc "${PVC_BLOCK}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pv "${PV_BLOCK}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pod "${POD_MPATH}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pvc "${PVC_MPATH}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
  kubectl delete pv "${PV_MPATH}" --ignore-not-found=true --timeout=60s >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "=== CKA Fibre Channel SAN Volume Test Suite ==="

# 1. Device path sanity check
echo "==> [1/4] Checking availability of Fibre Channel SAN target paths..."
FC_DEVICE_PATH="$(find /dev/disk/by-path/ -name "*fc-0x${WWPN_A}-lun-${FS_LUN}" 2>/dev/null | head -n1 || true)"
if [ -z "${FC_DEVICE_PATH}" ] || [ ! -e "${FC_DEVICE_PATH}" ]; then
  echo "Error: Fibre Channel SAN storage emulator is not deployed on this node." >&2
  echo "Hint: Run 'make preprod-fc' to deploy and configure the FC SAN emulator." >&2
  exit 1
fi
echo "    OK: FC SAN target path ${FC_DEVICE_PATH} is available."

# 2. Test Direct Pod Mount
echo "==> [2/4] Testing direct in-tree FC pod mount..."
kubectl delete pod "${POD_DIRECT}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
kubectl apply -f "${SCRIPT_DIR}/01-fc-direct-pod.yaml"
kubectl wait --for=condition=Ready pod/"${POD_DIRECT}" -n "${NAMESPACE}" --timeout=120s

echo "    Verifying file write on mounted Fibre Channel filesystem..."
DIRECT_CONTENT="$(kubectl exec "${POD_DIRECT}" -n "${NAMESPACE}" -- cat /mnt/storage/direct-test.txt)"
if echo "${DIRECT_CONTENT}" | grep -q "Fibre Channel SAN direct volume mounted"; then
  echo "    OK: Direct FC volume mount and write verified."
else
  echo "    FAIL: Unexpected content in /mnt/storage/direct-test.txt: ${DIRECT_CONTENT}" >&2
  exit 1
fi
kubectl delete pod "${POD_DIRECT}" -n "${NAMESPACE}" --timeout=60s

# 3. Test Static PV + PVC + Consumer Pod
echo "==> [3/4] Testing static PersistentVolume, PVC, and consumer Pod..."
kubectl delete pod "${POD_PVC}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
kubectl delete pvc "${PVC_NAME}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
kubectl delete pv "${PV_NAME}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
kubectl apply -f "${SCRIPT_DIR}/02-fc-pv-pvc-pod.yaml"
kubectl wait --for=condition=Ready pod/"${POD_PVC}" -n "${NAMESPACE}" --timeout=120s

echo "    Verifying PVC volume status and mount..."
PV_STATUS="$(kubectl get pv "${PV_NAME}" -o jsonpath='{.status.phase}')"
if [ "${PV_STATUS}" != "Bound" ]; then
  echo "    FAIL: PV '${PV_NAME}' phase is '${PV_STATUS}', expected Bound." >&2
  exit 1
fi
echo "    OK: Static PV '${PV_NAME}' is Bound."
PVC_CONTENT="$(kubectl exec "${POD_PVC}" -n "${NAMESPACE}" -- cat /mnt/storage/san-data.txt)"
if echo "${PVC_CONTENT}" | grep -q "Serving from Fibre Channel SAN volume"; then
  echo "    OK: Static PVC volume mount and write verified."
else
  echo "    FAIL: Unexpected content in /mnt/storage/san-data.txt: ${PVC_CONTENT}" >&2
  exit 1
fi
kubectl delete pod "${POD_PVC}" -n "${NAMESPACE}" --timeout=60s
kubectl delete pvc "${PVC_NAME}" -n "${NAMESPACE}" --timeout=60s
kubectl delete pv "${PV_NAME}" --timeout=60s

# 4. Test Raw Block Device Mode
echo "==> [4/4] Testing raw block device mode (volumeMode: Block)..."
kubectl delete pod "${POD_BLOCK}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
kubectl delete pvc "${PVC_BLOCK}" -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
kubectl delete pv "${PV_BLOCK}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
kubectl apply -f "${SCRIPT_DIR}/03-fc-raw-block.yaml"
kubectl wait --for=condition=Ready pod/"${POD_BLOCK}" -n "${NAMESPACE}" --timeout=120s

echo "    Verifying raw block special device inside container..."
if kubectl exec "${POD_BLOCK}" -n "${NAMESPACE}" -- test -b /dev/fcblock; then
  echo "    OK: Raw block device /dev/fcblock exists and is recognized as block special."
else
  echo "    FAIL: /dev/fcblock is not a block device." >&2
  exit 1
fi

echo "===================================================================="
echo "✔ SUCCESS: All Fibre Channel SAN volume drills validated successfully!"
echo "===================================================================="
