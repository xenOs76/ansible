apiVersion: apps/v1
kind: Deployment
metadata:
  name: cka-quarantine-app
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
spec:
  replicas: 3
  selector:
    matchLabels:
      app: prod-web
  template:
    metadata:
      labels:
        app: prod-web
    spec:
      containers:
      - name: web
        image: nginx:alpine
        ports:
        - containerPort: 80
        resources:
          requests:
            cpu: 10m
            memory: 16Mi
---
apiVersion: v1
kind: Service
metadata:
  name: cka-quarantine-svc
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
spec:
  type: ClusterIP
  selector:
    app: prod-web
  ports:
  - port: 80
    targetPort: 80
