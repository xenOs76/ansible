apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-finite-worker
  namespace: {{ cka_lab_pods_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-finite-worker
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: pods
spec:
  restartPolicy: Never
  containers:
    - name: worker
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
      args:
        - |
          for step in $(seq 1 4); do
            echo "[cka-lab-finite-worker] Step ${step}/4 completed."
            sleep 1
          done
          echo "[cka-lab-finite-worker] Work complete. Exiting with code 0."
          exit 0
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
