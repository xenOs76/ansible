apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-native-sidecar-pod
  namespace: {{ cka_lab_workloads_advanced_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-native-sidecar-pod
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: workloads-advanced
spec:
  initContainers:
    - name: telemetry-sidecar
      image: busybox:1.36.1
      restartPolicy: Always
      command:
        - /bin/sh
        - -c
        - "while true; do echo 'Sidecar telemetry active'; sleep 5; done"
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
  containers:
    - name: primary-app
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - "echo 'Primary application service running' && sleep 3600"
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
