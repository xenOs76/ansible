#!/usr/bin/env bash
set -euo pipefail

# Verify PKI certificate status and cluster control plane health
echo "=== Verifying PKI Certificate Expiration and Health ==="

# 1. Verify kubeadm check-expiration executes successfully
if ! sudo kubeadm certs check-expiration >/dev/null 2>&1; then
    echo "FAIL: kubeadm certs check-expiration failed to run."
    exit 1
fi
echo "[1/3] kubeadm certs check-expiration passed."

# 2. Verify apiserver.crt validity using OpenSSL
APISERVER_CRT="/etc/kubernetes/pki/apiserver.crt"
if [[ -f "${APISERVER_CRT}" ]]; then
    if ! sudo openssl x509 -in "${APISERVER_CRT}" -checkend 86400 -noout >/dev/null 2>&1; then
        echo "FAIL: apiserver.crt is expired or expiring within 24 hours!"
        exit 1
    fi
    echo "[2/3] apiserver.crt is valid for at least 24 hours."
else
    echo "FAIL: ${APISERVER_CRT} does not exist."
    exit 1
fi

# 3. Verify API server responsiveness
if ! kubectl get nodes >/dev/null 2>&1; then
    echo "FAIL: Kubernetes API server unreachable after certificate check."
    exit 1
fi
echo "[3/3] Kubernetes API server is healthy and responding to queries."

echo "=== PKI Certificate Verification PASSED ==="
