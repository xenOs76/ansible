---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: cka-manual-pv
  labels:
    app.kubernetes.io/part-of: cka-lab
    tier: storage-drill
spec:
  capacity:
    storage: 5Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: manual-storage
  hostPath:
    path: /tmp/cka-pv-data
    type: DirectoryOrCreate
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: cka-mismatched-pvc
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
spec:
  storageClassName: manual-storage
  # Mismatch 1: ReadWriteMany vs PV ReadWriteOnce
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      # Mismatch 2: 10Gi requested vs 5Gi PV capacity
      storage: 10Gi
