#!/usr/bin/env bash
# ==============================================================================
# fix-kubelet.sh: Restores Valid Kubelet Configuration & Verifies Health
# Managed by Ansible (roles/cka_lab)
# Supports local node execution or remote worker targeting (--node=kube-worker-1)
# Restores config.yaml, kubeadm-flags.env, and 10-kubeadm.conf across all scenarios
# ==============================================================================
set -euo pipefail

TARGET_NODE="local"

for arg in "$@"; do
  case "${arg}" in
    --node=*)
      TARGET_NODE="${arg#*=}"
      ;;
    local|kube-*|worker*|control-plane*)
      TARGET_NODE="${arg}"
      ;;
    -h|--help)
      echo "Usage: $0 [--node=<node>]"
      exit 0
      ;;
    *)
      echo "Error: Unknown option '${arg}'." >&2
      echo "Usage: $0 [--node=<node>]" >&2
      exit 1
      ;;
  esac
done

fix_local_kubelet() {
  local CONFIG="/var/lib/kubelet/config.yaml"
  local CONFIG_BAK="/var/lib/kubelet/config.yaml.bak"
  local FLAGS="/var/lib/kubelet/kubeadm-flags.env"
  local FLAGS_BAK="/var/lib/kubelet/kubeadm-flags.env.bak"
  local SYSTEMD_CONF="/etc/systemd/system/kubelet.service.d/10-kubeadm.conf"
  local SYSTEMD_CONF_BAK="/etc/systemd/system/kubelet.service.d/10-kubeadm.conf.bak"

  if [ "$(id -u)" -ne 0 ]; then
    echo "Error: Modifying system service configs requires root (use sudo)." >&2
    exit 1
  fi

  # 1. Restore config.yaml
  if [ -f "${CONFIG_BAK}" ]; then
    echo "==> Restoring ${CONFIG} from backup..."
    cp -f "${CONFIG_BAK}" "${CONFIG}"
    rm -f "${CONFIG_BAK}"
  elif [ -f "${CONFIG}" ]; then
    sed -i '/corrupted_unmarshal_syntax:/d' "${CONFIG}"
    sed -i 's|invalidDriverName|systemd|g' "${CONFIG}"
  fi

  # 2. Restore kubeadm-flags.env
  if [ -f "${FLAGS_BAK}" ]; then
    echo "==> Restoring ${FLAGS} from backup..."
    cp -f "${FLAGS_BAK}" "${FLAGS}"
    rm -f "${FLAGS_BAK}"
  elif [ -f "${FLAGS}" ]; then
    sed -i 's|containerd-broken.sock|containerd.sock|g' "${FLAGS}"
  fi

  # 3. Restore 10-kubeadm.conf
  if [ -f "${SYSTEMD_CONF_BAK}" ]; then
    echo "==> Restoring ${SYSTEMD_CONF} from backup..."
    cp -f "${SYSTEMD_CONF_BAK}" "${SYSTEMD_CONF}"
    rm -f "${SYSTEMD_CONF_BAK}"
  elif [ -f "${SYSTEMD_CONF}" ]; then
    sed -i 's|config-broken.yaml|config.yaml|g' "${SYSTEMD_CONF}"
  fi

  echo "==> Reloading systemd daemon and restarting kubelet..."
  systemctl daemon-reload
  systemctl restart kubelet

  echo "==> Verifying local kubelet service state..."
  for i in $(seq 1 15); do
    if systemctl is-active --quiet kubelet; then
      echo "==> [SUCCESS] Kubelet service is active and running!"
      systemctl status kubelet --no-pager -l
      return 0
    fi
    echo "    Attempt ${i}/15: Waiting for kubelet to become active..."
    sleep 2
  done
  echo "==> [ERROR] Kubelet failed to start. Inspect with: sudo journalctl -u kubelet -e" >&2
  return 1
}

fix_remote_kubelet() {
  local target="${1}"
  local target_host="${target}"

  if ! getent hosts "${target}" >/dev/null 2>&1; then
    local k8s_ip
    k8s_ip="$(kubectl get node "${target}" -o jsonpath='{.status.addresses[?(@.type=="InternalIP")].address}' 2>/dev/null || true)"
    if [ -n "${k8s_ip}" ]; then
      echo "==> [NOTICE] '${target}' resolved via Kubernetes Node API to ${k8s_ip}"
      target_host="${k8s_ip}"
    fi
  fi

  echo "==> Restoring kubelet configuration on remote node: ${target} (${target_host})..."
  ssh -o StrictHostKeyChecking=no "${target_host}" "sudo bash -c '
    CONFIG=\"/var/lib/kubelet/config.yaml\"
    CONFIG_BAK=\"/var/lib/kubelet/config.yaml.bak\"
    FLAGS=\"/var/lib/kubelet/kubeadm-flags.env\"
    FLAGS_BAK=\"/var/lib/kubelet/kubeadm-flags.env.bak\"
    SYSTEMD_CONF=\"/etc/systemd/system/kubelet.service.d/10-kubeadm.conf\"
    SYSTEMD_CONF_BAK=\"/etc/systemd/system/kubelet.service.d/10-kubeadm.conf.bak\"

    if [ -f \"\${CONFIG_BAK}\" ]; then
      cp -f \"\${CONFIG_BAK}\" \"\${CONFIG}\"
      rm -f \"\${CONFIG_BAK}\"
    elif [ -f \"\${CONFIG}\" ]; then
      sed -i \"/corrupted_unmarshal_syntax:/d\" \"\${CONFIG}\"
      sed -i \"s|invalidDriverName|systemd|g\" \"\${CONFIG}\"
    fi

    if [ -f \"\${FLAGS_BAK}\" ]; then
      cp -f \"\${FLAGS_BAK}\" \"\${FLAGS}\"
      rm -f \"\${FLAGS_BAK}\"
    elif [ -f \"\${FLAGS}\" ]; then
      sed -i \"s|containerd-broken.sock|containerd.sock|g\" \"\${FLAGS}\"
    fi

    if [ -f \"\${SYSTEMD_CONF_BAK}\" ]; then
      cp -f \"\${SYSTEMD_CONF_BAK}\" \"\${SYSTEMD_CONF}\"
      rm -f \"\${SYSTEMD_CONF_BAK}\"
    elif [ -f \"\${SYSTEMD_CONF}\" ]; then
      sed -i \"s|config-broken.yaml|config.yaml|g\" \"\${SYSTEMD_CONF}\"
    fi

    systemctl daemon-reload
    systemctl restart kubelet
  '"

  echo "==> Awaiting ${target} Ready status in Kubernetes..."
  for i in $(seq 1 20); do
    if kubectl get node "${target}" --no-headers 2>/dev/null | grep -wq "Ready"; then
      echo "==> [SUCCESS] Node ${target} is Ready!"
      kubectl get node "${target}"
      return 0
    fi
    echo "    Attempt ${i}/20: Waiting for ${target} to report Ready..."
    sleep 3
  done
  echo "==> [ERROR] Node ${target} did not report Ready within 60s." >&2
  return 1
}

if [ "${TARGET_NODE}" = "local" ] || [ "${TARGET_NODE}" = "$(hostname)" ]; then
  echo "===================================================================="
  echo "  [CKA LAB] Restoring Kubelet on Local Host ($(hostname))           "
  echo "===================================================================="
  fix_local_kubelet
else
  echo "===================================================================="
  echo "  [CKA LAB] Restoring Kubelet on Remote Node: ${TARGET_NODE}        "
  echo "===================================================================="
  fix_remote_kubelet "${TARGET_NODE}"
fi

