apiVersion: v1
kind: ConfigMap
metadata:
  name: cka-immutable-config
  namespace: {{ cka_lab_configmaps_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: configmaps-immutable
immutable: true
data:
  max_connections: "100"
  cache_ttl: "3600"
  cluster_env: "prod-immutable"
