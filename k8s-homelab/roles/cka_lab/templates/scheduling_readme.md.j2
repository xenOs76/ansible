kubectl explain pod.spec.affinity.podAntiAffinity
kubectl explain quota.spec.hard
kubectl explain limitrange.spec.limits
kubectl explain priorityclass
kubectl taint nodes <node-name> key=value:NoSchedule
kubectl taint nodes <node-name> key=value:NoSchedule-
```

