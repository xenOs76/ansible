apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: rbd-claim-raw-block
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: rbd-volumes
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Block
  storageClassName: {{ cka_lab_rbd_storage_class }}
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: rbd-raw-block-consumer-pod
  namespace: default
  labels:
    app: rbd-raw-block-consumer
    app.kubernetes.io/part-of: cka-lab
spec:
  containers:
    - name: block-tester
      image: busybox:1.36
      command:
        - sh
        - -c
        - |
          echo "Raw block device ready at /dev/rbdblock"
          sleep 3600
      volumeDevices:
        - name: raw-block-vol
          devicePath: /dev/rbdblock
  volumes:
    - name: raw-block-vol
      persistentVolumeClaim:
        claimName: rbd-claim-raw-block
