apiVersion: v1
kind: Secret
metadata:
  name: api-auth-credentials
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-secret
type: Opaque
stringData:
  api-token.txt: "cka-lab-mock-api-token-value"
  service-account-config.json: '{"auth_type": "service_account", "client_email": "demo@cka-lab.local"}'
---
apiVersion: v1
kind: Pod
metadata:
  name: secret-volume-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-secret
spec:
  containers:
    - name: api-client
      image: busybox:1.36
      command: ["sh", "-c", "ls -l /etc/secrets && sleep 3600"]
      volumeMounts:
        - name: secret-volume
          mountPath: /etc/secrets
          readOnly: true
  volumes:
    - name: secret-volume
      secret:
        secretName: api-auth-credentials
        defaultMode: 256  # 0400 in octal is 256 in decimal
