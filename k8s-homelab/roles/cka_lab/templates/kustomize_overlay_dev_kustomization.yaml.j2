---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: {{ cka_lab_configmaps_dev_namespace }}

namePrefix: dev-

commonAnnotations:
  team: frontend-dev
  contact: dev@os76.xyz

labels:
  - includeSelectors: true
    pairs:
      environment: {{ cka_lab_configmaps_dev_namespace }}
      cka.practice/layer: overlay

resources:
  - ../../base

configMapGenerator:
  - name: webapp-config
    behavior: merge
    literals:
      - APP_MSG=Development Sandbox Environment
    files:
      - dev-settings.properties
    envs:
      - dev-app.env

secretGenerator:
  - name: webapp-secret
    behavior: merge
    envs:
      - dev-secrets.env

generatorOptions:
  disableNameSuffixHash: true

patches:
  - target:
      kind: Deployment
      name: webapp-deployment
    path: patches/patch-memory-replace.yaml
  - target:
      kind: Deployment
      name: webapp-deployment
    path: patches/patch-remove-probe.yaml
