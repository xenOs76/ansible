apiVersion: apps/v1
kind: Deployment
metadata:
  name: cka-lab-anti-affinity-deploy
  namespace: {{ cka_lab_scheduling_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-anti-affinity-deploy
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: scheduling
spec:
  replicas: 2
  selector:
    matchLabels:
      app: cka-lab-anti-affinity-app
  template:
    metadata:
      labels:
        app: cka-lab-anti-affinity-app
        cka.practice/scenario: scheduling
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: app
                    operator: In
                    values:
                      - cka-lab-anti-affinity-app
              topologyKey: "kubernetes.io/hostname"
      containers:
        - name: app
          image: busybox:1.36.1
          command: ["/bin/sh", "-c", "sleep 3600"]
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
