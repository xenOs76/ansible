apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: cka-lab-httproute-advanced
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-httproute-advanced
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  parentRefs:
    - name: cka-lab-gateway
      namespace: {{ cka_lab_helm_ngf_namespace | default('nginx-gateway') }}
      sectionName: http
  hostnames:
    - "{{ cka_lab_networking_gateway_domain | default('httpbin.example.local') }}"
  rules:
    - name: complex-canary-match
      matches:
        # Match condition 1 (Logical AND: path /api/v2 AND header version: 2 AND query param env=canary AND method GET)
        - path:
            type: PathPrefix
            value: /api/v2
          headers:
            - type: Exact
              name: version
              value: "2"
          queryParams:
            - type: Exact
              name: env
              value: canary
          method: GET
        # Match condition 2 (Logical OR with condition 1: matches path /canary/api unconditionally)
        - path:
            type: PathPrefix
            value: /canary/api
      filters:
        - type: RequestHeaderModifier
          requestHeaderModifier:
            add:
              - name: X-Gateway-Routed-By
                value: CKA-NGINX-Gateway-Fabric
              - name: X-Route-Type
                value: advanced-canary
            remove:
              - X-Internal-Secret
      backendRefs:
        - name: cka-lab-ingress-api-svc
          port: 80
          weight: 90
        - name: cka-lab-backend-app
          port: 80
          weight: 10
      timeouts:
        request: 10s
        backendRequest: 2s
    - name: method-get-only
      matches:
        - path:
            type: PathPrefix
            value: /v1/data
          method: GET
      backendRefs:
        - name: cka-lab-ingress-api-svc
          port: 80
    - name: legacy-redirect
      matches:
        - path:
            type: PathPrefix
            value: /legacy-api
      filters:
        - type: RequestRedirect
          requestRedirect:
            statusCode: 301
            path:
              type: ReplaceFullPath
              replaceFullPath: /api
