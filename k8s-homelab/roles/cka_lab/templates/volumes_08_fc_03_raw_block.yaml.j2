---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: fc-raw-block-pv
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
    storage-tier: fc-san
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  volumeMode: Block
  storageClassName: ""
  fc:
    targetWWNs:
      - "{{ cka_lab_fc_target_wwns[0] }}"
    lun: {{ cka_lab_fc_block_lun | default(1) }}
    readOnly: false
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: fc-raw-block-pvc
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Block
  storageClassName: ""
  resources:
    requests:
      storage: 500Mi
  volumeName: fc-raw-block-pv
---
apiVersion: v1
kind: Pod
metadata:
  name: fc-raw-block-consumer-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: fc-volumes
spec:
  containers:
    - name: raw-writer
      image: alpine:latest
      command: ["/bin/sh", "-c"]
      args:
        - |
          echo "Writing test signature to raw Fibre Channel block LUN..."
          echo "CKA_FC_RAW_BLOCK_MAGIC_2026" | dd of=/dev/fcblock bs=512 count=1 conv=notrunc
          sync
          while true; do sleep 3600; done
      volumeDevices:
        - name: raw-block-vol
          devicePath: /dev/fcblock
  volumes:
    - name: raw-block-vol
      persistentVolumeClaim:
        claimName: fc-raw-block-pvc
