#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="${SCRIPT_DIR}/01-quarantine-app.yaml"

echo "=== Pod Quarantine & Autopsy Interactive Drill ==="

echo "[1/4] Deploying 3-replica application..."
kubectl apply -f "${MANIFEST}"
kubectl rollout status deployment cka-quarantine-app -n default --timeout=60s

TARGET_POD=$(kubectl get pods -l app=prod-web -o jsonpath='{.items[0].metadata.name}')
echo "Selected target pod to isolate: ${TARGET_POD}"

echo "[2/4] Relabeling ${TARGET_POD} to app=quarantine..."
kubectl label pod "${TARGET_POD}" app=quarantine --overwrite

echo "[3/4] Observing replica replacement..."
sleep 3
kubectl get pods --show-labels

POD_COUNT=$(kubectl get pods -l app=prod-web --no-headers | wc -l)
echo "Active healthy pods matching app=prod-web: ${POD_COUNT} (Expected: 3)"

echo "[4/4] Quarantined pod status:"
kubectl get pod "${TARGET_POD}" -o wide
echo "The isolated pod ${TARGET_POD} remains alive for investigation without receiving service traffic."

echo "Cleaning up..."
kubectl delete pod "${TARGET_POD}" --now
kubectl delete -f "${MANIFEST}"
echo "=== Drill completed successfully! ==="
