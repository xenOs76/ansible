---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: netpol-test-client
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: netpol-test-client
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
    app: netpol-client
spec:
  replicas: 1
  selector:
    matchLabels:
      app: netpol-client
  template:
    metadata:
      labels:
        app: netpol-client
        app.kubernetes.io/name: netpol-test-client
        app.kubernetes.io/part-of: cka-lab
        cka.practice/scenario: networking
    spec:
      containers:
        - name: client
          image: curlimages/curl:latest
          command:
            - /bin/sh
            - -c
            - while true; do sleep 3600; done
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 64Mi
