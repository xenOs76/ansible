apiVersion: v1
kind: Pod
metadata:
  name: cka-bulk-secret-pod
  namespace: {{ cka_lab_secrets_default_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: secrets-envfrom
spec:
  restartPolicy: Never
  containers:
    - name: consumer
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
        - |
          echo "=== Bulk Secret Environment Variables (prefix SEC_) ==="
          env | grep "^SEC_" || true
          sleep 3600
      envFrom:
        - prefix: SEC_
          secretRef:
            name: sample-app-secret
