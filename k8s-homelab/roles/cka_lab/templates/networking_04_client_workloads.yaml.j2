---
apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-client-authorized
  namespace: {{ cka_lab_networking_client_namespace | default('cka-lab-net-client') }}
  labels:
    app.kubernetes.io/name: cka-lab-client-authorized
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
    app: cka-lab-client
    access: authorized
spec:
  restartPolicy: Always
  containers:
    - name: client
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
      args:
        - while true; do sleep 3600; done
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
---
apiVersion: v1
kind: Pod
metadata:
  name: cka-lab-client-unauthorized
  namespace: {{ cka_lab_networking_client_namespace | default('cka-lab-net-client') }}
  labels:
    app.kubernetes.io/name: cka-lab-client-unauthorized
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
    app: cka-lab-client
    access: unauthorized
spec:
  restartPolicy: Always
  containers:
    - name: client
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
      args:
        - while true; do sleep 3600; done
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
