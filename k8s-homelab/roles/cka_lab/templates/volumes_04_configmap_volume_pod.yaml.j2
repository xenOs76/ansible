apiVersion: v1
kind: ConfigMap
metadata:
  name: app-runtime-config
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-configmap
data:
  app.conf: |
    server_port=8080
    log_level=info
    cache_ttl=300
  feature-flags.json: |
    {"enableMetrics": true, "betaFeatures": false}
---
apiVersion: v1
kind: Pod
metadata:
  name: configmap-volume-pod
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-configmap
spec:
  containers:
    - name: app
      image: busybox:1.36
      command: ["sh", "-c", "cat /etc/config/app.conf && sleep 3600"]
      volumeMounts:
        - name: config-volume
          mountPath: /etc/config
          readOnly: true
  volumes:
    - name: config-volume
      configMap:
        name: app-runtime-config
        defaultMode: 0644
