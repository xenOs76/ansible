---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: cka-mismatched-pvc
  namespace: default
  labels:
    app.kubernetes.io/part-of: cka-lab
spec:
  storageClassName: manual-storage
  # Corrected: ReadWriteOnce matches PV specification
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      # Corrected: 5Gi matches PV capacity
      storage: 5Gi
