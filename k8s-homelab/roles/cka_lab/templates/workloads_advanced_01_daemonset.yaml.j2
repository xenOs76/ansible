apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: cka-lab-log-collector-ds
  namespace: {{ cka_lab_workloads_advanced_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-log-collector-ds
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: workloads-advanced
spec:
  selector:
    matchLabels:
      app: cka-lab-log-collector
  template:
    metadata:
      labels:
        app: cka-lab-log-collector
        cka.practice/scenario: workloads-advanced
    spec:
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
        - name: collector
          image: busybox:1.36.1
          command:
            - /bin/sh
            - -c
            - "echo 'Log collector daemon active on host' && sleep 3600"
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
          volumeMounts:
            - name: host-log
              mountPath: /var/log
              readOnly: true
      volumes:
        - name: host-log
          hostPath:
            path: /var/log
            type: Directory
