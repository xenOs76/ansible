# Verify routing to Web backend (/web -> cka-lab-ingress-web-svc)
curl -i -H "Host: {{ cka_lab_networking_domain | default('cka-lab.example.local') }}" \
  "http://${NODE_IP}:{{ cka_lab_networking_ingress_http_port | default(31080) }}/web"

# Verify routing to API backend (/api -> cka-lab-ingress-api-svc)
curl -i -H "Host: {{ cka_lab_networking_domain | default('cka-lab.example.local') }}" \
  "http://${NODE_IP}:{{ cka_lab_networking_ingress_http_port | default(31080) }}/api"
```

