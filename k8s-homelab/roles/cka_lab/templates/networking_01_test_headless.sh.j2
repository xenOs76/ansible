#!/usr/bin/env bash
set -euo pipefail

# Test headless service DNS record resolution
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAMESPACE="{{ cka_lab_networking_namespace | default('default') }}"
MANIFEST="${SCRIPT_DIR}/cka-lab-headless-service.yaml"
if [[ ! -f "${MANIFEST}" ]]; then
    MANIFEST="${SCRIPT_DIR}/03-headless-service.yaml"
fi

echo "=== Testing Headless Service & DNS Discovery ==="

if [[ -f "${MANIFEST}" ]]; then
    kubectl apply -f "${MANIFEST}" -n "${NAMESPACE}"
fi

echo "Waiting for StatefulSet rollout..."
kubectl rollout status statefulset cka-headless-app -n "${NAMESPACE}" --timeout=60s

echo "Querying DNS A-record for headless service cka-headless-svc.${NAMESPACE}.svc.cluster.local..."
kubectl run test-headless-dns -n "${NAMESPACE}" --rm -i --restart=Never --image=busybox:1.36 -- nslookup "cka-headless-svc.${NAMESPACE}.svc.cluster.local"

echo "Querying individual pod DNS: cka-headless-app-0.cka-headless-svc.${NAMESPACE}.svc.cluster.local..."
kubectl run test-pod-dns -n "${NAMESPACE}" --rm -i --restart=Never --image=busybox:1.36 -- nslookup "cka-headless-app-0.cka-headless-svc.${NAMESPACE}.svc.cluster.local"

echo "=== Headless Service DNS Test PASSED ==="
