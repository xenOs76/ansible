#!/usr/bin/env bash
set -euo pipefail

# Test headless service DNS record resolution
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="${SCRIPT_DIR}/03-headless-service.yaml"

echo "=== Testing Headless Service & DNS Discovery ==="

if [[ -f "${MANIFEST}" ]]; then
    kubectl apply -f "${MANIFEST}"
fi

echo "Waiting for StatefulSet rollout..."
kubectl rollout status statefulset cka-headless-app -n default --timeout=60s

echo "Querying DNS A-record for headless service cka-headless-svc.default.svc.cluster.local..."
kubectl run test-headless-dns --rm -i --restart=Never --image=busybox:1.36 -- nslookup cka-headless-svc.default.svc.cluster.local

echo "Querying individual pod DNS: cka-headless-app-0.cka-headless-svc.default.svc.cluster.local..."
kubectl run test-pod-dns --rm -i --restart=Never --image=busybox:1.36 -- nslookup cka-headless-app-0.cka-headless-svc.default.svc.cluster.local

echo "=== Headless Service DNS Test PASSED ==="
