apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nfs-dynamic-claim
  namespace: {{ cka_lab_storage_classes_namespace | default('default') }}
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: storage-classes
spec:
  accessModes:
    - ReadWriteMany
  storageClassName: {{ cka_lab_nfs_csi_storage_class | default('nfs-csi') }}
  resources:
    requests:
      storage: 500Mi
