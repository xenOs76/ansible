apiVersion: v1
kind: PersistentVolume
metadata:
  name: cka-reclaim-pv
  labels:
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: volumes-lifecycle
spec:
  capacity:
    storage: 500Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Delete
  hostPath:
    path: /tmp/reclaim-test-data
    type: DirectoryOrCreate
