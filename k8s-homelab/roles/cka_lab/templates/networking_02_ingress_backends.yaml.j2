---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cka-lab-ingress-web
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-ingress-web
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cka-lab-ingress-web
  template:
    metadata:
      labels:
        app: cka-lab-ingress-web
        cka.practice/scenario: networking
    spec:
      containers:
        - name: web
          image: nginx:alpine
          ports:
            - containerPort: 80
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
---
apiVersion: v1
kind: Service
metadata:
  name: cka-lab-ingress-web-svc
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-ingress-web-svc
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  type: ClusterIP
  selector:
    app: cka-lab-ingress-web
  ports:
    - name: http
      port: 80
      targetPort: 80
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cka-lab-ingress-api
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-ingress-api
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cka-lab-ingress-api
  template:
    metadata:
      labels:
        app: cka-lab-ingress-api
        cka.practice/scenario: networking
    spec:
      containers:
        - name: api
          image: busybox:1.36.1
          command:
            - /bin/sh
            - -c
          args:
            - |
              while true; do
                echo -e "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{\"status\":\"ok\",\"service\":\"cka-lab-ingress-api\"}" | nc -l -p 8080
              done
          ports:
            - containerPort: 8080
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
---
apiVersion: v1
kind: Service
metadata:
  name: cka-lab-ingress-api-svc
  namespace: {{ cka_lab_networking_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: cka-lab-ingress-api-svc
    app.kubernetes.io/part-of: cka-lab
    cka.practice/scenario: networking
spec:
  type: ClusterIP
  selector:
    app: cka-lab-ingress-api
  ports:
    - name: http
      port: 80
      targetPort: 8080
