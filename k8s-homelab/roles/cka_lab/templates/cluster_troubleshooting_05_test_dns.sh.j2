#!/usr/bin/env bash
set -euo pipefail

# Verify DNS resolution in the cluster
echo "=== Verifying Cluster DNS Resolution ==="

# Check coredns pods
kubectl get pods -n kube-system -l k8s-app=kube-dns

# Run ephemeral query
kubectl run dns-test-runner --rm -i --restart=Never --image=busybox:1.36 -- nslookup kubernetes.default.svc.cluster.local

echo "=== CoreDNS Resolution Verification PASSED ==="
