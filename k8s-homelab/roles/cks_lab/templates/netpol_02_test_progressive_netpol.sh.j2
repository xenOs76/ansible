#!/usr/bin/env bash
# ==============================================================================
# test-progressive-netpol.sh: Automated Progressive Zero-Trust NetworkPolicy Drill
# Scenario: Strict Default-Deny, DNS Egress Controls, and Microservice Whitelisting
# ==============================================================================
set -euo pipefail

NAMESPACE="{{ cks_lab_netpol_namespace | default('default') }}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== [CKS NetPol Drill 2] Progressive Microsegmentation & Zero-Trust Lockdown ==="

cleanup() {
  echo ""
  echo "==> Cleaning up progressive NetworkPolicies and test workloads..."
  kubectl delete -f "${SCRIPT_DIR}/05-allow-internal-api.yaml" -n "${NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1 || true
  kubectl delete -f "${SCRIPT_DIR}/04-allow-external-dns.yaml" -n "${NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1 || true
  kubectl delete -f "${SCRIPT_DIR}/03-allow-kube-dns.yaml" -n "${NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1 || true
  kubectl delete -f "${SCRIPT_DIR}/02-default-deny-all.yaml" -n "${NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1 || true
  kubectl delete deployment netpol-test-client internal-api -n "${NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1 || true
  kubectl delete service internal-api -n "${NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1 || true
}
trap cleanup EXIT

# Clean up any leftover resources before starting
cleanup

# ------------------------------------------------------------------------------
# 1. Deploy Test Workloads & Verify Baseline Connectivity
# ------------------------------------------------------------------------------
echo "==> [Phase 1] Deploying test client and internal API workloads..."
kubectl apply -f "${SCRIPT_DIR}/01-workloads.yaml" -n "${NAMESPACE}"
kubectl rollout status deployment/netpol-test-client -n "${NAMESPACE}" --timeout=60s
kubectl rollout status deployment/internal-api -n "${NAMESPACE}" --timeout=60s

CLIENT_POD=$(kubectl get pods -n "${NAMESPACE}" -l app=netpol-client -o jsonpath='{.items[0].metadata.name}')

echo "    Testing open baseline connectivity (client -> internal-api:8080)..."
BASELINE_STATUS=$(kubectl exec "${CLIENT_POD}" -n "${NAMESPACE}" -- curl -s -m 5 -o /dev/null -w "%{http_code}" "http://internal-api:8080" || echo "000")
if [ "${BASELINE_STATUS}" != "200" ]; then
  echo "    ERROR: Expected HTTP 200 from internal-api, got ${BASELINE_STATUS}" >&2
  exit 1
fi
echo "    OK: Initial baseline connectivity verified (HTTP 200)."

# ------------------------------------------------------------------------------
# 2. Enforce Strict Default-Deny (Ingress & Egress)
# ------------------------------------------------------------------------------
echo "==> [Phase 2] Applying strict namespace default-deny-all (Ingress & Egress)..."
kubectl apply -f "${SCRIPT_DIR}/02-default-deny-all.yaml" -n "${NAMESPACE}"
sleep 2

echo "    Verifying client egress to internal API is blocked (expect TIMEOUT)..."
if kubectl exec "${CLIENT_POD}" -n "${NAMESPACE}" -- curl -s -m 3 "http://internal-api:8080" >/dev/null 2>&1; then
  echo "    FAIL: Internal traffic succeeded unexpectedly under default-deny!" >&2
  exit 1
else
  echo "    OK: Traffic dropped by default-deny policy as expected."
fi

# ------------------------------------------------------------------------------
# 3. Whitelist In-Cluster CoreDNS
# ------------------------------------------------------------------------------
echo "==> [Phase 3] Applying CoreDNS egress policy (kube-system:53)..."
kubectl apply -f "${SCRIPT_DIR}/03-allow-kube-dns.yaml" -n "${NAMESPACE}"
sleep 2

echo "    Verifying in-cluster DNS resolution..."
if kubectl exec "${CLIENT_POD}" -n "${NAMESPACE}" -- nslookup kubernetes.default.svc.cluster.local >/dev/null 2>&1; then
  echo "    OK: CoreDNS resolution succeeded."
else
  echo "    FAIL: CoreDNS resolution failed under allow-kube-dns policy!" >&2
  exit 1
fi

echo "    Verifying general HTTP traffic remains blocked..."
if kubectl exec "${CLIENT_POD}" -n "${NAMESPACE}" -- curl -s -m 3 "http://internal-api:8080" >/dev/null 2>&1; then
  echo "    FAIL: Internal API traffic succeeded before allow rule was applied!" >&2
  exit 1
else
  echo "    OK: Microservice traffic remains blocked as expected."
fi

# ------------------------------------------------------------------------------
# 4. Whitelist External Public DNS via ipBlock
# ------------------------------------------------------------------------------
echo "==> [Phase 4] Applying external DNS egress policy (ipBlock)..."
kubectl apply -f "${SCRIPT_DIR}/04-allow-external-dns.yaml" -n "${NAMESPACE}"
sleep 2

echo "    Verifying public DNS queries against 1.1.1.1..."
if kubectl exec "${CLIENT_POD}" -n "${NAMESPACE}" -- nslookup google.com 1.1.1.1 >/dev/null 2>&1; then
  echo "    OK: External DNS resolution against 1.1.1.1 succeeded."
else
  echo "    Notice: Public DNS to 1.1.1.1 not reachable or offline in lab VM environment."
fi

# ------------------------------------------------------------------------------
# 5. Whitelist Internal Microservice API Egress & Ingress
# ------------------------------------------------------------------------------
echo "==> [Phase 5] Applying microservice allow policies (client <-> internal-api)..."
kubectl apply -f "${SCRIPT_DIR}/05-allow-internal-api.yaml" -n "${NAMESPACE}"
sleep 2

echo "    Verifying client can communicate with internal-api:8080 (expect SUCCESS)..."
RESTORED_STATUS=$(kubectl exec "${CLIENT_POD}" -n "${NAMESPACE}" -- curl -s -m 5 -o /dev/null -w "%{http_code}" "http://internal-api:8080" || echo "000")
if [ "${RESTORED_STATUS}" != "200" ]; then
  echo "    FAIL: Expected HTTP 200 from internal-api, got ${RESTORED_STATUS}" >&2
  exit 1
fi
echo "    OK: Microservice communication successfully restored by policy (HTTP 200)."

# ------------------------------------------------------------------------------
# 6. Hubble CLI Diagnostic Visibility
# ------------------------------------------------------------------------------
echo "==> [Phase 6] Checking Hubble CLI status..."
if command -v hubble >/dev/null 2>&1; then
  echo "    Hubble CLI is installed and available on path."
  echo "    Trainee tip: Run 'cilium hubble port-forward &' followed by 'hubble observe --namespace ${NAMESPACE} --verdict DROPPED' to inspect live drops."
fi

echo ""
echo "=== [SUCCESS] Progressive zero-trust microsegmentation drill completed! ==="
