apiVersion: v1
kind: Pod
metadata:
  name: seccomp-unconfined
  namespace: default
  labels:
    app: seccomp-drill
spec:
  restartPolicy: Never
  containers:
    - name: test
      image: busybox:1.36.1
      command: ["sh", "-c", "mkdir -p /tmp/seccomp-test-dir && ls -d /tmp/seccomp-test-dir && sleep 3600"]
      securityContext:
        seccompProfile:
          type: Unconfined
