apiVersion: v1
kind: Pod
metadata:
  name: apparmor-deny-write
  namespace: default
  labels:
    app: apparmor-drill
spec:
  restartPolicy: Never
  containers:
    - name: test
      image: busybox:1.36.1
      command: ["sh", "-c", "echo 'Testing write restriction' > /tmp/write-test.txt || exit 0"]
      securityContext:
        appArmorProfile:
          type: Localhost
          localhostProfile: k8s-deny-write
