---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-kube-dns-egress
  namespace: {{ cks_lab_netpol_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: allow-kube-dns-egress
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
