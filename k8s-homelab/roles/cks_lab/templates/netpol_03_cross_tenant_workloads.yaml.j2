---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cks_lab_netpol_tenant_a | default('cks-tenant-a') }}
  labels:
    kubernetes.io/metadata.name: {{ cks_lab_netpol_tenant_a | default('cks-tenant-a') }}
    team: frontend
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cks_lab_netpol_tenant_b | default('cks-tenant-b') }}
  labels:
    kubernetes.io/metadata.name: {{ cks_lab_netpol_tenant_b | default('cks-tenant-b') }}
    team: backend
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: secure-db
  namespace: {{ cks_lab_netpol_tenant_b | default('cks-tenant-b') }}
  labels:
    app.kubernetes.io/name: secure-db
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  replicas: 1
  selector:
    matchLabels:
      role: database
  template:
    metadata:
      labels:
        role: database
        app.kubernetes.io/name: secure-db
        app.kubernetes.io/part-of: cks-lab
        cks.practice/scenario: network-policies
    spec:
      containers:
        - name: database
          image: busybox:1.36.1
          command:
            - /bin/sh
            - -c
            - |
              mkdir -p /var/www && echo "PostgreSQL Mock 5432 OK" > /var/www/index.html
              exec httpd -f -p 5432 -h /var/www
          ports:
            - containerPort: 5432
              name: pg-mock
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 64Mi
---
apiVersion: v1
kind: Service
metadata:
  name: db-service
  namespace: {{ cks_lab_netpol_tenant_b | default('cks-tenant-b') }}
  labels:
    app.kubernetes.io/name: db-service
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  type: ClusterIP
  ports:
    - port: 5432
      targetPort: 5432
      protocol: TCP
      name: pg-mock
  selector:
    role: database
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend-app
  namespace: {{ cks_lab_netpol_tenant_a | default('cks-tenant-a') }}
  labels:
    app.kubernetes.io/name: frontend-app
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  replicas: 1
  selector:
    matchLabels:
      role: frontend
  template:
    metadata:
      labels:
        role: frontend
        app.kubernetes.io/name: frontend-app
        app.kubernetes.io/part-of: cks-lab
        cks.practice/scenario: network-policies
    spec:
      containers:
        - name: client
          image: curlimages/curl:latest
          command:
            - /bin/sh
            - -c
            - while true; do sleep 3600; done
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 64Mi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: analytics-worker
  namespace: {{ cks_lab_netpol_tenant_a | default('cks-tenant-a') }}
  labels:
    app.kubernetes.io/name: analytics-worker
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  replicas: 1
  selector:
    matchLabels:
      role: analytics
  template:
    metadata:
      labels:
        role: analytics
        app.kubernetes.io/name: analytics-worker
        app.kubernetes.io/part-of: cks-lab
        cks.practice/scenario: network-policies
    spec:
      containers:
        - name: client
          image: curlimages/curl:latest
          command:
            - /bin/sh
            - -c
            - while true; do sleep 3600; done
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 64Mi
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-all
  namespace: {{ cks_lab_netpol_tenant_a | default('cks-tenant-a') }}
  labels:
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-all
  namespace: {{ cks_lab_netpol_tenant_b | default('cks-tenant-b') }}
  labels:
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-kube-dns
  namespace: {{ cks_lab_netpol_tenant_a | default('cks-tenant-a') }}
  labels:
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
