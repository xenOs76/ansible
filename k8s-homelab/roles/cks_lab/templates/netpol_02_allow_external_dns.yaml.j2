---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-external-dns-egress
  namespace: {{ cks_lab_netpol_namespace | default('default') }}
  labels:
    app.kubernetes.io/name: allow-external-dns-egress
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  podSelector:
    matchLabels:
      app: netpol-client
  policyTypes:
    - Egress
  egress:
    - to:
        - ipBlock:
            cidr: 1.1.1.1/32
        - ipBlock:
            cidr: 8.8.8.8/32
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
