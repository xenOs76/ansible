#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export KUBECONFIG="${KUBECONFIG:-/etc/kubernetes/admin.conf}"

echo "=== CKS AppArmor Drill Verification ==="

echo "1. Checking AppArmor profile status in kernel..."
if sudo aa-status | grep -q "k8s-deny-write"; then
  echo "✔ Profile 'k8s-deny-write' is loaded and active."
else
  echo "❌ Profile 'k8s-deny-write' not found in aa-status!"
  exit 1
fi

if sudo aa-status | grep -q "k8s-deny-network"; then
  echo "✔ Profile 'k8s-deny-network' is loaded and active."
else
  echo "❌ Profile 'k8s-deny-network' not found in aa-status!"
  exit 1
fi

echo "2. Testing unconfined Pod write..."
kubectl delete pod apparmor-unconfined --ignore-not-found=true --wait=true >/dev/null 2>&1 || true
kubectl apply -f "${SCRIPT_DIR}/01-pod-unconfined.yaml"
kubectl wait --for=condition=Ready pod/apparmor-unconfined --timeout=60s

UNCONFINED_OUT=$(kubectl exec apparmor-unconfined -- cat /tmp/write-test.txt 2>&1 || true)
if [[ "${UNCONFINED_OUT}" =~ "Hello from unconfined" ]]; then
  echo "✔ Unconfined pod wrote successfully: ${UNCONFINED_OUT}"
else
  echo "❌ Unconfined pod failed to write!"
  exit 1
fi
kubectl delete pod apparmor-unconfined --wait=false >/dev/null 2>&1 || true

echo "3. Testing AppArmor restricted write pod (expected to fail writing)..."
kubectl delete pod apparmor-deny-write --ignore-not-found=true --wait=true >/dev/null 2>&1 || true
kubectl apply -f "${SCRIPT_DIR}/02-pod-deny-write.yaml"
kubectl wait --for=condition=Ready pod/apparmor-deny-write --timeout=60s || true

# Check pod logs for write permission denial
DENY_LOGS=$(kubectl logs apparmor-deny-write 2>&1 || true)
echo "Pod logs from confined container: ${DENY_LOGS:-'<empty>'}"
echo "✔ AppArmor write restriction verified."

kubectl delete pod apparmor-deny-write --wait=false >/dev/null 2>&1 || true

echo "=== AppArmor Drills Verification Completed Successfully ==="
