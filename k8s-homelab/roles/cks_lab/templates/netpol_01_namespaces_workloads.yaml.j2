---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cks_lab_netpol_client_namespace | default('cks-net-client') }}
  labels:
    kubernetes.io/metadata.name: {{ cks_lab_netpol_client_namespace | default('cks-net-client') }}
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
    tier: client
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cks_lab_netpol_backend_namespace | default('cks-net-backend') }}
  labels:
    kubernetes.io/metadata.name: {{ cks_lab_netpol_backend_namespace | default('cks-net-backend') }}
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
    tier: backend
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cks-lab-target-backend
  namespace: {{ cks_lab_netpol_backend_namespace | default('cks-net-backend') }}
  labels:
    app.kubernetes.io/name: cks-lab-target-backend
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
    app: cks-lab-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cks-lab-backend
  template:
    metadata:
      labels:
        app: cks-lab-backend
        cks.practice/scenario: network-policies
    spec:
      containers:
        - name: backend-service
          image: nginx:alpine
          ports:
            - containerPort: 80
              name: http
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
---
apiVersion: v1
kind: Service
metadata:
  name: cks-lab-target-backend-svc
  namespace: {{ cks_lab_netpol_backend_namespace | default('cks-net-backend') }}
  labels:
    app.kubernetes.io/name: cks-lab-target-backend-svc
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
spec:
  type: ClusterIP
  selector:
    app: cks-lab-backend
  ports:
    - name: http
      port: 80
      targetPort: 80
---
apiVersion: v1
kind: Pod
metadata:
  name: cks-lab-client-authorized
  namespace: {{ cks_lab_netpol_client_namespace | default('cks-net-client') }}
  labels:
    app.kubernetes.io/name: cks-lab-client-authorized
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
    app: cks-lab-client
    access: authorized
spec:
  restartPolicy: Always
  containers:
    - name: client
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
      args:
        - while true; do sleep 3600; done
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
---
apiVersion: v1
kind: Pod
metadata:
  name: cks-lab-client-unauthorized
  namespace: {{ cks_lab_netpol_client_namespace | default('cks-net-client') }}
  labels:
    app.kubernetes.io/name: cks-lab-client-unauthorized
    app.kubernetes.io/part-of: cks-lab
    cks.practice/scenario: network-policies
    app: cks-lab-client
    access: unauthorized
spec:
  restartPolicy: Always
  containers:
    - name: client
      image: busybox:1.36.1
      command:
        - /bin/sh
        - -c
      args:
        - while true; do sleep 3600; done
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          cpu: 50m
          memory: 32Mi
