#!/usr/bin/env bash
# ==============================================================================
# Script: test-ceph-storage.sh
# Purpose: Comprehensive end-to-end verification for Ceph RBD, CephFS, and CephNFS.
#          Managed by Ansible (roles/rook_ceph).
# ==============================================================================
set -euo pipefail

RBD_STORAGE_CLASS="{{ rook_ceph_storage_class_name }}"
CEPHFS_STORAGE_CLASS="{{ rook_ceph_fs_storage_class_name }}"
NFS_SERVER_HOST="{{ nfs_server_hostname | default('nfs-server.local') }}"
NFS_EXPORT_PATH="{{ rook_ceph_nfs_export_path | default('/exports') }}"
NAMESPACE="default"

RUN_RBD=true
RUN_CEPHFS=true
RUN_NFS=true

# Parse arguments
if [[ $# -gt 0 ]]; then
  case "$1" in
    --rbd)
      RUN_RBD=true
      RUN_CEPHFS=false
      RUN_NFS=false
      shift
      ;;
    --cephfs)
      RUN_RBD=false
      RUN_CEPHFS=true
      RUN_NFS=false
      shift
      ;;
    --nfs)
      RUN_RBD=false
      RUN_CEPHFS=false
      RUN_NFS=true
      shift
      ;;
    --all)
      RUN_RBD=true
      RUN_CEPHFS=true
      RUN_NFS=true
      shift
      ;;
    -h|--help)
      echo "Usage: $(basename "$0") [--all | --rbd | --cephfs | --nfs] [namespace]"
      exit 0
      ;;
  esac
fi

if [[ $# -gt 0 ]]; then
  NAMESPACE="$1"
fi

# Detect KUBECONFIG if not set
if [ -z "${KUBECONFIG:-}" ] && [ -f /etc/kubernetes/admin.conf ] && [ ! -f "${HOME}/.kube/config" ]; then
  export KUBECONFIG=/etc/kubernetes/admin.conf
fi

WORKER_NODE=$(kubectl get nodes -l '!node-role.kubernetes.io/control-plane' -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
if [ -z "${WORKER_NODE}" ]; then
  WORKER_NODE="kube-worker-1"
fi

cleanup() {
  echo "==> Cleaning up any leftover test resources..."
  kubectl delete pod test-rook-rbd-pod test-rook-cephfs-pod test-rook-nfs-pod -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
  kubectl delete pvc test-rook-rbd-pvc test-rook-cephfs-pvc -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "===================================================================="
echo "          Ceph Dynamic Storage End-to-End Verification              "
echo "===================================================================="
echo "Target Worker Node: ${WORKER_NODE}"
echo "Namespace:          ${NAMESPACE}"
echo ""

# ------------------------------------------------------------------------------
# 1. Ceph RBD Block Storage Drill
# ------------------------------------------------------------------------------
if [ "${RUN_RBD}" = "true" ]; then
  echo "--------------------------------------------------------------------"
  echo "==> [Drill 1/3] Testing Ceph RBD Dynamic Block Storage (RWO)..."
  echo "--------------------------------------------------------------------"
  if ! kubectl get storageclass "${RBD_STORAGE_CLASS}" >/dev/null 2>&1; then
    echo "Notice: StorageClass '${RBD_STORAGE_CLASS}' not found, skipping RBD test."
  else
    cat <<EOF | kubectl apply -n "${NAMESPACE}" -f -
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: test-rook-rbd-pvc
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ${RBD_STORAGE_CLASS}
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: test-rook-rbd-pod
spec:
  nodeName: ${WORKER_NODE}
  terminationGracePeriodSeconds: 1
  containers:
    - name: writer
      image: busybox:1.36
      command: ["sh", "-c", "echo 'Ceph RBD block volume verified on \$(hostname) at \$(date)' > /mnt/ceph/rbd-status.txt && sleep 120"]
      volumeMounts:
        - name: rbd-vol
          mountPath: /mnt/ceph
  volumes:
    - name: rbd-vol
      persistentVolumeClaim:
        claimName: test-rook-rbd-pvc
EOF

    echo "Waiting for RBD pod to reach Ready status..."
    if kubectl wait pod test-rook-rbd-pod -n "${NAMESPACE}" --for=condition=Ready --timeout=120s; then
      RBD_CONTENT=$(kubectl exec test-rook-rbd-pod -n "${NAMESPACE}" -- cat /mnt/ceph/rbd-status.txt)
      echo "  ✔ RBD Output: ${RBD_CONTENT}"
      echo "  ✔ PASS: Ceph RBD block storage dynamically provisioned & mounted successfully!"
    else
      echo "  ✖ FAIL: Ceph RBD test pod failed to become ready." >&2
      kubectl describe pod test-rook-rbd-pod -n "${NAMESPACE}" >&2
      exit 1
    fi

    kubectl delete pod test-rook-rbd-pod -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
    kubectl delete pvc test-rook-rbd-pvc -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
  fi
  echo ""
fi

# ------------------------------------------------------------------------------
# 2. CephFS Filesystem Storage Drill
# ------------------------------------------------------------------------------
if [ "${RUN_CEPHFS}" = "true" ]; then
  echo "--------------------------------------------------------------------"
  echo "==> [Drill 2/3] Testing CephFS Dynamic Shared Filesystem (RWX)..."
  echo "--------------------------------------------------------------------"
  if ! kubectl get storageclass "${CEPHFS_STORAGE_CLASS}" >/dev/null 2>&1; then
    echo "Notice: StorageClass '${CEPHFS_STORAGE_CLASS}' not found, skipping CephFS test."
  else
    cat <<EOF | kubectl apply -n "${NAMESPACE}" -f -
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: test-rook-cephfs-pvc
spec:
  accessModes:
    - ReadWriteMany
  storageClassName: ${CEPHFS_STORAGE_CLASS}
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: test-rook-cephfs-pod
spec:
  nodeName: ${WORKER_NODE}
  terminationGracePeriodSeconds: 1
  containers:
    - name: writer
      image: busybox:1.36
      command: ["sh", "-c", "echo 'CephFS shared volume verified on \$(hostname) at \$(date)' > /mnt/cephfs/status.txt && sleep 120"]
      volumeMounts:
        - name: cephfs-vol
          mountPath: /mnt/cephfs
  volumes:
    - name: cephfs-vol
      persistentVolumeClaim:
        claimName: test-rook-cephfs-pvc
EOF

    echo "Waiting for CephFS pod to reach Ready status..."
    if kubectl wait pod test-rook-cephfs-pod -n "${NAMESPACE}" --for=condition=Ready --timeout=120s; then
      CEPHFS_CONTENT=$(kubectl exec test-rook-cephfs-pod -n "${NAMESPACE}" -- cat /mnt/cephfs/status.txt)
      echo "  ✔ CephFS Output: ${CEPHFS_CONTENT}"
      echo "  ✔ PASS: CephFS shared filesystem dynamically provisioned & mounted successfully!"
    else
      echo "  ✖ FAIL: CephFS test pod failed to become ready." >&2
      kubectl describe pod test-rook-cephfs-pod -n "${NAMESPACE}" >&2
      exit 1
    fi

    kubectl delete pod test-rook-cephfs-pod -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
    kubectl delete pvc test-rook-cephfs-pvc -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
  fi
  echo ""
fi

# ------------------------------------------------------------------------------
# 3. Ceph NFS Export Mount Drill
# ------------------------------------------------------------------------------
if [ "${RUN_NFS}" = "true" ]; then
  echo "--------------------------------------------------------------------"
  echo "==> [Drill 3/3] Testing Ceph NFS Export Mount (${NFS_SERVER_HOST}:${NFS_EXPORT_PATH})..."
  echo "--------------------------------------------------------------------"
  cat <<EOF | kubectl apply -n "${NAMESPACE}" -f -
apiVersion: v1
kind: Pod
metadata:
  name: test-rook-nfs-pod
spec:
  nodeName: ${WORKER_NODE}
  terminationGracePeriodSeconds: 1
  containers:
    - name: writer
      image: busybox:1.36
      command: ["sh", "-c", "echo 'Ceph NFS export mounted on \$(hostname) at \$(date)' >> /mnt/nfs/ceph-nfs-test.txt && sleep 120"]
      volumeMounts:
        - name: nfs-vol
          mountPath: /mnt/nfs
  volumes:
    - name: nfs-vol
      nfs:
        server: ${NFS_SERVER_HOST}
        path: ${NFS_EXPORT_PATH}
EOF

  echo "Waiting for Ceph NFS test pod to reach Ready status..."
  if kubectl wait pod test-rook-nfs-pod -n "${NAMESPACE}" --for=condition=Ready --timeout=90s; then
    NFS_CONTENT=$(kubectl exec test-rook-nfs-pod -n "${NAMESPACE}" -- tail -n 1 /mnt/nfs/ceph-nfs-test.txt)
    echo "  ✔ NFS Output: ${NFS_CONTENT}"
    echo "  ✔ PASS: Ceph NFS export mounted and verified via in-tree nfs volume from ${WORKER_NODE}!"
  else
    echo "  ✖ FAIL: Ceph NFS test pod failed to become ready." >&2
    kubectl describe pod test-rook-nfs-pod -n "${NAMESPACE}" >&2
    exit 1
  fi

  kubectl delete pod test-rook-nfs-pod -n "${NAMESPACE}" --ignore-not-found=true --timeout=30s >/dev/null 2>&1 || true
  echo ""
fi

echo "===================================================================="
echo "🎉 ALL REQUESTED CEPH STORAGE TESTS PASSED SUCCESSFULLY!"
echo "===================================================================="
