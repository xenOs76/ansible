# -*- mode: ruby -*-
# vi: set ft=ruby :

# Read topology from ENV or .topology dotfile (default: standard)
TOPOLOGY_FILE = File.expand_path(".topology", __dir__)
TOPOLOGY = ENV["TOPOLOGY"] || (File.exist?(TOPOLOGY_FILE) ? File.read(TOPOLOGY_FILE).strip : "standard")

BOX_IMAGE = ENV.fetch("BOX_IMAGE", "cloud-image/ubuntu-26.04")
K8S_VERSION = ENV.fetch("K8S_VERSION", "1.36.0-1.1")
K9S_VERSION = ENV.fetch("K9S_VERSION", "v0.51.0")
ETCD_VERSION = ENV.fetch("ETCD_VERSION", "v3.5.16")
KREW_VERSION = ENV.fetch("KREW_VERSION", "v0.5.0")
CYCLONUS_VERSION = ENV.fetch("CYCLONUS_VERSION", "v0.2.1")
ROOT_DISK_SIZE = ENV.fetch("ROOT_DISK_SIZE", "25").to_i

if TOPOLOGY == "ha"
  CP_NODES = {
    "kube-cp-1" => { ip: "192.168.56.10", ram: 2560, cpu: 2, secondary_disk: true },
    "kube-cp-2" => { ip: "192.168.56.11", ram: 2560, cpu: 2, secondary_disk: false },
    "kube-cp-3" => { ip: "192.168.56.12", ram: 2560, cpu: 2, secondary_disk: false }
  }
  WORKER_NODES = {
    "kube-worker-1" => { ip: "192.168.56.21", ram: 2048, cpu: 2 }
  }
else
  CP_NODES = {
    "kube-control-plane" => { ip: "192.168.56.10", ram: 4096, cpu: 2, secondary_disk: true }
  }
  WORKER_COUNT = ENV.fetch("WORKER_COUNT", "2").to_i
  WORKER_NODES = {}
  (1..WORKER_COUNT).each do |i|
    WORKER_NODES["kube-worker-#{i}"] = { ip: "192.168.56.#{i + 20}", ram: 2048, cpu: 2 }
  end
end

Vagrant.configure("2") do |config|
  config.vm.box = BOX_IMAGE

  # Ensure default SSH shell is bash
  config.ssh.shell = "bash -l"

  config.vm.synced_folder ".", "/vagrant", type: "9p", disabled: false, accessmode: "squash"

  # Control plane node(s) definition
  CP_NODES.each do |name, props|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network :private_network, ip: props[:ip]

      node.vm.provider :libvirt do |lv|
        lv.driver = "kvm"
        lv.memory = props[:ram]
        lv.cpus = props[:cpu]
        lv.machine_virtual_size = ROOT_DISK_SIZE
        if props[:secondary_disk]
          lv.storage :file, size: '20G', type: 'qcow2', device: 'vdb', allow_existing: true
        end
      end

      node.vm.provision "file", source: "scripts/cni-install-cilium.sh", destination: "/home/vagrant/cni-install-cilium.sh"
      node.vm.provision "file", source: "scripts/cni-install-hubble.sh", destination: "/home/vagrant/cni-install-hubble.sh"
      node.vm.provision "file", source: "scripts/cni-install-calico.sh", destination: "/home/vagrant/cni-install-calico.sh"
      node.vm.provision "shell", inline: "chmod +x /home/vagrant/*.sh && chown vagrant:vagrant /home/vagrant/*.sh"

      node.vm.provision "shell", path: "scripts/common.sh", env: { "K8S_VERSION" => K8S_VERSION }
      node.vm.provision "shell", path: "scripts/control-plane-tools.sh", env: {
        "K9S_VERSION" => K9S_VERSION,
        "ETCD_VERSION" => ETCD_VERSION,
        "KREW_VERSION" => KREW_VERSION,
        "CYCLONUS_VERSION" => CYCLONUS_VERSION
      }
    end
  end

  # Worker node(s) definition
  WORKER_NODES.each do |name, props|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network :private_network, ip: props[:ip]

      node.vm.provider :libvirt do |lv|
        lv.driver = "kvm"
        lv.memory = props[:ram]
        lv.cpus = props[:cpu]
        lv.machine_virtual_size = ROOT_DISK_SIZE
      end

      node.vm.provision "shell", path: "scripts/common.sh", env: { "K8S_VERSION" => K8S_VERSION }
    end
  end

  config.vm.provision "shell",
    inline: <<-SHELL
      echo "==> Running system package upgrade (apt-get upgrade)..."
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y
      apt-get upgrade -y
      apt-get clean -y
    SHELL

  config.vm.provision "shell",
    run: "always",
    inline: <<-SHELL
      chsh -s /bin/bash vagrant || usermod -s /bin/bash vagrant
      swapoff -a
    SHELL
end
